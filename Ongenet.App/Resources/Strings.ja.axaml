    <system:String x:Key="Transport_Master_volume_A11yName">Master volume</system:String>
    <system:String x:Key="Transport_Metronome_A11yName">Metronome</system:String>
    <system:String x:Key="Transport_Metronome_click_during_playback_Tip">Metronome click during 再生</system:String>
    <system:String x:Key="Transport_Ongenet_process_CPU_usage_Tip">Ongenet process CPU usage</system:String>
    <system:String x:Key="Transport_Ongenet_process_memory_working_set_Tip">Ongenet process memory (working set)</system:String>
    <system:String x:Key="Transport_Open_export_dialog_for_audio_render">開く エクスポート dialog for オーディオ レンダー</system:String>
    <system:String x:Key="Transport_Open_export_dialog_for_audio_render_A11yHelp">開く エクスポート dialog for オーディオ レンダー</system:String>
