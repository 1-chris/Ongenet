    <system:String x:Key="Transport_Project_tempo_in_beats_per_minute">プロジェクト tempo in beats per minute</system:String>
    <system:String x:Key="Transport_Project_tempo_in_beats_per_minute_A11yHelp">プロジェクト tempo in beats per minute</system:String>
    <system:String x:Key="Transport_Record_A11yName">録音</system:String>
    <system:String x:Key="Transport_Record_into_armed_tracks_with_count_in">カウントイン付きでアームしたトラックに録音</system:String>
    <system:String x:Key="Transport_Record_into_armed_tracks_with_count_in_A11yHelp">カウントイン付きでアームしたトラックに録音</system:String>
    <system:String x:Key="Transport_Record_one_bar_count_in_into_armed_tracks_Tip">録音（アームしたトラックへ 1 小節カウントイン）</system:String>
    <system:String x:Key="Transport_Rendering_Tip">レンダーing…</system:String>
