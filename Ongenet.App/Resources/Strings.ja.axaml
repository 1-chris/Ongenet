    <system:String x:Key="PatternInspector_Mute_this_pattern_row_its_steps_stay_in_the_grid_Tip">ミュート this パターン row — its steps stay in the grid but produce no sound until unmuted.</system:String>
    <system:String x:Key="PatternInspector_Name_of_the_pattern_object_one_pattern_can_be_us_Tip">Name of the パターン object — one パターン can be used by multiple パターン クリップ on the timeline.</system:String>
    <system:String x:Key="PatternInspector_One_row_in_the_pattern_corresponds_to_a_channel__Tip">One row in the パターン — corresponds to a チャンネル in the step grid. Each row triggers its インストゥルメント or サンプル when steps are lit.</system:String>
