    <system:String x:Key="PatternInspector_Pattern_tracks_hold_step_sequencer_style_pattern_Tip">パターン トラック hold step-sequencer-style パターンs (like FL Studio チャンネル racks) — each row triggers an インストゥルメント or サンプル when steps are active in the パターン エディター.</system:String>
    <system:String x:Key="PatternInspector_Pick_an_audio_clip_from_the_project_library_to_f_Tip">Pick an オーディオ クリップ from the プロジェクト library to fire when steps on this row are 有効.</system:String>
