    <system:String x:Key="Timeline_Reverse">Reverse</system:String>
    <system:String x:Key="Timeline_Ripple_delete">Ripple delete</system:String>
    <system:String x:Key="Timeline_Ripple_insert">Ripple insert</system:String>
    <system:String x:Key="Timeline_S">S</system:String>
    <system:String x:Key="Timeline_Send_to_Session_Slot">Send to Session Slot</system:String>
    <system:String x:Key="Timeline_Separate_stems_4_way">Separate stems (4-way)</system:String>
    <system:String x:Key="Timeline_Solo_Tip">Solo</system:String>
    <system:String x:Key="Timeline_Split_comp_at_playhead">Split comp at playhead</system:String>
    <system:String x:Key="Timeline_Text">●</system:String>
    <system:String x:Key="Timeline_Text_2">✕</system:String>
    <system:String x:Key="Timeline_Timeline_A11yName">Timeline</system:String>
    <system:String x:Key="Timeline_Tracks">Tracks</system:String>
    <system:String x:Key="Timeline_Unlink">Unlink</system:String>
    <system:String x:Key="TrackInspector_Add_a_pan_LFO_that_automatically_sweeps_the_trac_Tip">Add a pan LFO that automatically sweeps the track left and right — classic auto-pan for pads, percussion, and spatial movement.</system:String>
    <system:String x:Key="TrackInspector_Add_a_reverb_or_delay_return_in_the_mixer_to_cre">Add a reverb or delay return in the mixer to create sends.</system:String>
    <system:String x:Key="TrackInspector_Add_a_send_to_an_existing_return_track_Returns_m_Tip">Add a send to an existing return track. Returns must be created in the mixer (e.g. a Reverb return) before they appear here.</system:String>
    <system:String x:Key="TrackInspector_Add_a_volume_LFO_that_rhythmically_raises_and_lo_Tip">Add a volume LFO that rhythmically raises and lowers track level — classic tremolo or pulsing sidechain-style movement without an envelope follower.</system:String>
    <system:String x:Key="TrackInspector_Add_pan_LFO">Add pan LFO</system:String>
    <system:String x:Key="TrackInspector_Add_volume_LFO">Add volume LFO</system:String>
    <system:String x:Key="TrackInspector_Auxiliary_sends_route_part_of_this_track_to_retu_Tip">Auxiliary sends — route part of this track to return buses for shared time-based effects (reverb, delay, chorus). Create return tracks in the mixer first.</system:String>
    <system:String x:Key="TrackInspector_Basic_track_identity_and_mix_settings_how_the_tr_Tip">Basic track identity and mix settings — how the track is named, coloured on the timeline, and balanced in the stereo or surround field.</system:String>
    <system:String x:Key="TrackInspector_Bypass_the_volume_LFO_without_deleting_its_setti_Tip">Bypass the volume LFO without deleting its settings — useful for comparing with and without modulation.</system:String>
    <system:String x:Key="TrackInspector_C_LFE">C/LFE</system:String>
    <system:String x:Key="TrackInspector_Center_and_subwoofer_LFE_gains_Tip">Center and subwoofer (LFE) gains.</system:String>
    <system:String x:Key="TrackInspector_Center_channel_level_0200_Tip">Center channel level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Channel">Channel</system:String>
    <system:String x:Key="TrackInspector_Choose_an_accent_colour_for_this_tracks_header_a_Tip">Choose an accent colour for this track's header and lane gutter. Purely visual — use consistent colours across similar track types to scan the timeline faster.</system:String>
    <system:String x:Key="TrackInspector_Colour">Colour</system:String>
    <system:String x:Key="TrackInspector_Control_how_much_the_LFO_moves_the_fader_Start_a_Tip">Control how much the LFO moves the fader. Start around 20–40% for subtle motion; raise for obvious tremolo.</system:String>
    <system:String x:Key="TrackInspector_Current_LFO_rate_in_hertz_Tip">Current LFO rate in hertz.</system:String>
    <system:String x:Key="TrackInspector_Current_macro_amount_0_bypasses_all_LFO_depth_10_Tip">Current macro amount: 0% bypasses all LFO depth, 100% uses each LFO's full depth setting.</system:String>
    <system:String x:Key="TrackInspector_Current_pan_LFO_depth_how_far_pan_swings_from_ce_Tip">Current pan LFO depth — how far pan swings from center (100% reaches hard left/right extremes).</system:String>
    <system:String x:Key="TrackInspector_Current_pan_LFO_speed_cycles_per_second_the_pan__Tip">Current pan LFO speed — cycles per second the pan position sweeps left to right.</system:String>
    <system:String x:Key="TrackInspector_Current_pan_position_negative_left_0_center_posi_Tip">Current pan position: negative = left, 0 = center, positive = right.</system:String>
    <system:String x:Key="TrackInspector_Current_track_fader_level_as_a_percentage_of_uni_Tip">Current track fader level as a percentage of unity gain (100%).</system:String>
    <system:String x:Key="TrackInspector_Current_volume_LFO_depth_as_a_percentage_Tip">Current volume LFO depth as a percentage.</system:String>
    <system:String x:Key="TrackInspector_DRUM_MAP">DRUM MAP</system:String>
    <system:String x:Key="TrackInspector_Depth">Depth</system:String>
    <system:String x:Key="TrackInspector_Drag_the_puck_to_place_the_track_in_the_51_field_Tip">Drag the puck to place the track in the 5.1 field. Width (W) controls how diffuse vs. pinpoint the image is — narrow for dialog or lead, wide for pads and ambience.</system:String>
    <system:String x:Key="TrackInspector_Drag_to_set_how_loud_this_track_plays_relative_t_Tip">Drag to set how loud this track plays relative to other tracks. Affects playback and export; does not change individual clip levels.</system:String>
    <system:String x:Key="TrackInspector_Drum_maps_translate_MIDI_note_numbers_into_reada_Tip">Drum maps translate MIDI note numbers into readable drum names (Kick, Snare, Hi-hat, etc.) in the piano roll and notation. Assign one on instrument tracks that play drum kits.</system:String>
    <system:String x:Key="TrackInspector_EXTERNAL_MIDI">EXTERNAL MIDI</system:String>
    <system:String x:Key="TrackInspector_Edit_the_track_name_This_is_for_organization_onl_Tip">Edit the track name. This is for organization only — it does not rename underlying audio files or MIDI clips.</system:String>
    <system:String x:Key="TrackInspector_Enable_or_bypass_the_pan_LFO_without_losing_its__Tip">Enable or bypass the pan LFO without losing its rate and depth settings.</system:String>
    <system:String x:Key="TrackInspector_Enable_to_drive_an_external_MIDI_device_from_thi_Tip">Enable to drive an external MIDI device from this track. Configure the output port in Settings → Audio/MIDI. Internal instruments on the track may still play unless removed.</system:String>
    <system:String x:Key="TrackInspector_Enabled">Enabled</system:String>
    <system:String x:Key="TrackInspector_External_MIDI_routing_sends_this_tracks_notes_an_Tip">External MIDI routing sends this track's notes and controllers to a hardware synth, drum machine, or external plugin host instead of (or alongside) Ongenet's internal instruments.</system:String>
    <system:String x:Key="TrackInspector_FL">FL</system:String>
    <system:String x:Key="TrackInspector_FR">FR</system:String>
    <system:String x:Key="TrackInspector_FREEZE">FREEZE</system:String>
    <system:String x:Key="TrackInspector_Freeze_is_a_CPU_saving_bounce_Ongenet_renders_ev_Tip">Freeze is a CPU-saving bounce: Ongenet renders everything on this track offline into one audio clip so heavy synths and effects no longer run in real time. Your original clips, instruments, and FX are saved and restored when you unfreeze.</system:String>
    <system:String x:Key="TrackInspector_Freeze_track">Freeze track</system:String>
    <system:String x:Key="TrackInspector_Freeze_track_offline_render_all_clips_instrument_Tip">Freeze track — offline-render all clips, instruments, MIDI FX, and audio FX on this track into a single audio clip. Playback becomes lightweight; the pre-freeze state is kept in memory for Unfreeze.</system:String>
    <system:String x:Key="TrackInspector_Front_left_channel_gain_Tip">Front left channel gain.</system:String>
    <system:String x:Key="TrackInspector_Front_left_speaker_level_0200_Tip">Front left speaker level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Front_right_channel_gain_Tip">Front right channel gain.</system:String>
    <system:String x:Key="TrackInspector_Front_right_speaker_level_0200_Tip">Front right speaker level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Frozen_tracks_play_from_the_bounced_audio_clip_C_Tip">Frozen tracks play from the bounced audio clip. Clip editing, instrument changes, and effect tweaks are disabled until you unfreeze. Mix controls (volume, pan, mute, solo, sends) still work.</system:String>
    <system:String x:Key="TrackInspector_How_strongly_the_LFO_affects_volume_higher_more__Tip">How strongly the LFO affects volume — higher = more dramatic level change.</system:String>
    <system:String x:Key="TrackInspector_LFO_depth_how_far_volume_deviates_from_the_fader_Tip">LFO depth — how far volume deviates from the fader setting. 0% = no effect; 100% = full sweep between silence and double intensity (scaled by Macro).</system:String>
    <system:String x:Key="TrackInspector_LFO_rate_in_Hz_how_many_full_cycles_per_second_t_Tip">LFO rate in Hz — how many full cycles per second the volume sweeps through. Lower = slow swell; higher = fast tremolo.</system:String>
    <system:String x:Key="TrackInspector_LFO_speed_in_cycles_per_second_ignored_when_Sync_Tip">LFO speed in cycles per second (ignored when Sync to tempo is on).</system:String>
    <system:String x:Key="TrackInspector_LFO_waveform_determines_the_shape_of_each_cycle__Tip">LFO waveform — determines the shape of each cycle (smooth sine, linear triangle, abrupt square, etc.).</system:String>
    <system:String x:Key="TrackInspector_Lock_LFO_speed_to_the_project_tempo_eg_quarter_n_Tip">Lock LFO speed to the project tempo (e.g. quarter-note pulses) instead of a fixed Hz rate — keeps modulation musically aligned when BPM changes.</system:String>
    <system:String x:Key="TrackInspector_Low_frequency_effects_subwoofer_level_0200_Tip">Low-frequency effects (subwoofer) level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Low_frequency_oscillator_affecting_track_volume__Tip">Low-frequency oscillator affecting track volume — creates tremolo or rhythmic pulsing.</system:String>
    <system:String x:Key="TrackInspector_Low_frequency_oscillator_modulating_stereo_pan_p_Tip">Low-frequency oscillator modulating stereo pan position.</system:String>
    <system:String x:Key="TrackInspector_MIDI_channel_on_the_external_port_must_match_the_Tip">MIDI channel on the external port — must match the channel your external synth is set to receive (1–16).</system:String>
    <system:String x:Key="TrackInspector_MODULATION">MODULATION</system:String>
    <system:String x:Key="TrackInspector_Macro">Macro</system:String>
    <system:String x:Key="TrackInspector_Master_depth_control_for_all_track_LFOs_scales_e_Tip">Master depth control for all track LFOs — scales every modulator together.</system:String>
    <system:String x:Key="TrackInspector_Modulation_macro_one_knob_that_scales_every_LFO__Tip">Modulation macro — one knob that scales every LFO on this track. Turn it down to tame all modulation at once during a mix, or up for more dramatic movement.</system:String>
    <system:String x:Key="TrackInspector_Move_the_track_in_the_stereo_field_Pan_is_applie_Tip">Move the track in the stereo field. Pan is applied after the track fader and before sends and the master bus.</system:String>
    <system:String x:Key="TrackInspector_Mute">Mute</system:String>
    <system:String x:Key="TrackInspector_Mute_silences_this_track_during_playback_and_exp_Tip">Mute silences this track during playback and export without removing its clips. Use it to A/B parts or temporarily hide a layer while editing others.</system:String>
    <system:String x:Key="TrackInspector_Mute_this_send_without_removing_it_handy_for_A_B_Tip">Mute this send without removing it — handy for A/B comparing dry vs. wet or temporarily disabling one effect.</system:String>
    <system:String x:Key="TrackInspector_Name">Name</system:String>
    <system:String x:Key="TrackInspector_Override_individual_51_speaker_levels_when_the_m_Tip">Override individual 5.1 speaker levels when the main surround panner is not enough — e.g. boost LFE on a kick-heavy track or trim rears on a vocal.</system:String>
    <system:String x:Key="TrackInspector_Pan">Pan</system:String>
    <system:String x:Key="TrackInspector_Pan_LFO">Pan LFO</system:String>
    <system:String x:Key="TrackInspector_Pan_LFO_controls_adjust_rate_and_depth_to_sweep__Tip">Pan LFO controls — adjust rate and depth to sweep the track across the stereo field.</system:String>
    <system:String x:Key="TrackInspector_Pan_LFO_depth_how_wide_the_auto_pan_swing_is_Low_Tip">Pan LFO depth — how wide the auto-pan swing is. Lower values keep motion near center; 100% pans fully across the field.</system:String>
    <system:String x:Key="TrackInspector_Pan_LFO_rate_slow_rates_0105_Hz_for_wide_stereo__Tip">Pan LFO rate: slow rates (0.1–0.5 Hz) for wide stereo sweeps; faster rates for jittery movement.</system:String>
    <system:String x:Key="TrackInspector_Pan_LFO_rhythmically_moves_the_track_across_the__Tip">Pan LFO — rhythmically moves the track across the stereo field. Pair with a slow rate and moderate depth for gentle motion, or fast rate for vibrato-like panning.</system:String>
    <system:String x:Key="TrackInspector_Per_channel_gains">Per-channel gains</system:String>
    <system:String x:Key="TrackInspector_Pick_the_LFO_shape_sine_triangle_for_smooth_swel_Tip">Pick the LFO shape: sine/triangle for smooth swells, square/saw for hard on/off pumping, random for organic drift.</system:String>
    <system:String x:Key="TrackInspector_Pre_fader">Pre-fader</system:String>
    <system:String x:Key="TrackInspector_Pre_fader_send_taps_the_signal_before_the_track__Tip">Pre-fader send taps the signal before the track fader — send level stays constant even when you ride the track volume. Post-fader (off) follows fader moves.</system:String>
    <system:String x:Key="TrackInspector_Rate_Hz">Rate (Hz)</system:String>
    <system:String x:Key="TrackInspector_Rear_left_level_0200_Tip">Rear left level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Rear_right_level_0200_Tip">Rear right level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Remove">Remove</system:String>
    <system:String x:Key="TrackInspector_Remove_the_pan_LFO_from_this_track_Tip">Remove the pan LFO from this track.</system:String>
    <system:String x:Key="TrackInspector_Remove_the_volume_LFO_from_this_track_entirely_Tip">Remove the volume LFO from this track entirely.</system:String>
    <system:String x:Key="TrackInspector_Renders_clips_instruments_and_effects_to_one_aud">Renders clips, instruments, and effects to one audio clip to save CPU. Unfreeze brings back the original editable track.</system:String>
    <system:String x:Key="TrackInspector_Return_track_receiving_this_send_the_aux_bus_whe_Tip">Return track receiving this send — the aux bus where the shared effect chain lives.</system:String>
    <system:String x:Key="TrackInspector_Route_to_MIDI_output">Route to MIDI output</system:String>
    <system:String x:Key="TrackInspector_SENDS">SENDS</system:String>
    <system:String x:Key="TrackInspector_SL_SR_RL_RR">SL/SR/RL/RR</system:String>
    <system:String x:Key="TrackInspector_Scale_all_track_LFO_depths_at_once_Handy_for_rid_Tip">Scale all track LFO depths at once. Handy for riding modulation intensity through a song without editing each LFO separately.</system:String>
    <system:String x:Key="TrackInspector_Select_a_track_to_edit_its_settings">Select a track to edit its settings.</system:String>
    <system:String x:Key="TrackInspector_Select_which_drum_map_labels_this_tracks_MIDI_no_Tip">Select which drum map labels this track's MIDI notes. Choose (none) for melodic instruments. Create or edit maps in Groove → Drum map editor.</system:String>
    <system:String x:Key="TrackInspector_Send_level_how_much_signal_goes_to_the_return_0__Tip">Send level — how much signal goes to the return. 0% = dry only; higher values add more wet effect from the return track.</system:String>
    <system:String x:Key="TrackInspector_Send_to_a_return_bus_controls_how_much_of_this_t_Tip">Send to a return bus — controls how much of this track feeds a shared effect (reverb, delay, etc.) on that return.</system:String>
    <system:String x:Key="TrackInspector_Sends_need_a_destination_return_track_In_the_mix_Tip">Sends need a destination return track. In the mixer, add a return bus with your reverb or delay chain, then use + here to send this track's audio to it.</system:String>
    <system:String x:Key="TrackInspector_Sends_tap_this_tracks_signal_to_return_tracks_au_Tip">Sends tap this track's signal to return tracks (aux buses) for shared effects like reverb and delay. Each send has its own level and can be pre- or post-fader.</system:String>
    <system:String x:Key="TrackInspector_Set_how_fast_the_volume_LFO_cycles_Very_low_rate_Tip">Set how fast the volume LFO cycles. Very low rates (0.05–0.2 Hz) give slow breathing; 4–8 Hz gives vibrato-like tremolo.</system:String>
    <system:String x:Key="TrackInspector_Set_the_MIDI_channel_sent_to_the_external_device_Tip">Set the MIDI channel sent to the external device. Channel 10 is the conventional General MIDI drum channel.</system:String>
    <system:String x:Key="TrackInspector_Side_and_rear_surround_channel_gains_Tip">Side and rear surround channel gains.</system:String>
    <system:String x:Key="TrackInspector_Side_left_level_0200_Tip">Side left level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Side_right_level_0200_Tip">Side right level (0–200%).</system:String>
    <system:String x:Key="TrackInspector_Slow_LFO_on_track_volume_proof_of_concept_modula">Slow LFO on track volume (proof-of-concept modulator).</system:String>
    <system:String x:Key="TrackInspector_Solo">Solo</system:String>
    <system:String x:Key="TrackInspector_Solo_isolates_this_track_when_any_track_is_soloe_Tip">Solo isolates this track: when any track is soloed, only soloed tracks are heard. Useful for focusing on one part while mixing or checking edits.</system:String>
    <system:String x:Key="TrackInspector_Stereo_pan_positions_the_track_between_left_and__Tip">Stereo pan — positions the track between left and right speakers. −1 is hard left, 0 is center, +1 is hard right.</system:String>
    <system:String x:Key="TrackInspector_Stereo_pan_positions_the_track_between_left_and__Tip_2">Stereo pan — positions the track between left and right speakers.</system:String>
    <system:String x:Key="TrackInspector_Surround_51">Surround (5.1)</system:String>
    <system:String x:Key="TrackInspector_Surround_panning_for_51_mixes_places_this_track__Tip">Surround panning for 5.1 mixes — places this track in the immersive field when exporting or monitoring in surround. Stereo pan still applies; these controls map the image to FL, FR, C, LFE, SL, SR, RL, and RR.</system:String>
    <system:String x:Key="TrackInspector_Surround_panning_for_51_output_positions_the_tra_Tip">Surround panning for 5.1 output — positions the track in the immersive speaker layout.</system:String>
    <system:String x:Key="TrackInspector_Surround_width_higher_values_spread_the_source_a_Tip">Surround width — higher values spread the source across more speakers; lower values keep it tighter and more localized.</system:String>
    <system:String x:Key="TrackInspector_Sync_to_tempo">Sync to tempo</system:String>
    <system:String x:Key="TrackInspector_TRACK">TRACK</system:String>
    <system:String x:Key="TrackInspector_Text">+</system:String>
    <system:String x:Key="TrackInspector_The_label_shown_on_the_timeline_track_header_in__Tip">The label shown on the timeline track header, in the mixer, and in export stems. Renaming does not affect clip or file names.</system:String>
    <system:String x:Key="TrackInspector_This_track_is_frozen_only_level_pan_mute_solo_an">This track is frozen — only level, pan, mute, solo, and sends are editable until you unfreeze.</system:String>
    <system:String x:Key="TrackInspector_Timeline_colour_helps_you_visually_group_related_Tip">Timeline colour — helps you visually group related tracks (drums, bass, vocals, etc.) in the arrangement view. Does not affect audio.</system:String>
    <system:String x:Key="TrackInspector_Track_Controls_shows_mix_and_routing_settings_fo_Tip">Track Controls shows mix and routing settings for the selected timeline track — name, mute/solo, level, pan, sends, groove, and more. Click any track header or lane to load it here.</system:String>
    <system:String x:Key="TrackInspector_Track_fader_overall_output_level_after_clip_gain_Tip">Track fader — overall output level after clip gain and before master bus processing. 100% is unity gain; lower values attenuate the whole track.</system:String>
    <system:String x:Key="TrackInspector_Track_fader_overall_output_level_after_clip_gain_Tip_2">Track fader — overall output level after clip gain and before master bus processing.</system:String>
    <system:String x:Key="TrackInspector_Track_freeze_temporarily_converts_a_track_to_aud_Tip">Track freeze — temporarily converts a track to audio so playback uses less CPU. Use it when a finished part has expensive instruments or effects but you still need to hear it while mixing the rest of the song.</system:String>
    <system:String x:Key="TrackInspector_Track_modulation_applies_automatic_movement_to_m_Tip">Track modulation applies automatic movement to mix parameters — LFOs that swell volume or sweep pan over time. Useful for tremolo, auto-pan, and subtle motion without drawing automation.</system:String>
    <system:String x:Key="TrackInspector_Typical_workflow_finish_writing_on_a_CPU_heavy_t_Tip">Typical workflow: finish writing on a CPU-heavy track, freeze it, then mix buses and add more layers without dropouts. While frozen you cannot edit clips, instruments, or effects — click Unfreeze to resume editing.</system:String>
    <system:String x:Key="TrackInspector_Unfreeze">Unfreeze</system:String>
    <system:String x:Key="TrackInspector_Unfreeze_discard_the_frozen_audio_clip_and_resto_Tip">Unfreeze — discard the frozen audio clip and restore the original clips, instruments, and effects exactly as they were before freeze. Use this when you need to tweak the part again.</system:String>
    <system:String x:Key="TrackInspector_Volume">Volume</system:String>
    <system:String x:Key="TrackInspector_Volume_LFO">Volume LFO</system:String>
    <system:String x:Key="TrackInspector_Volume_LFO_cyclically_modulates_track_level_Adju_Tip">Volume LFO — cyclically modulates track level. Adjust rate for speed, depth for intensity, and waveform for character (smooth sine vs. choppy square).</system:String>
    <system:String x:Key="TrackInspector_Volume_LFOs_repeat_a_cyclic_level_change_tremolo_Tip">Volume LFOs repeat a cyclic level change (tremolo). Sync to tempo for musical pulses, or run free in Hz for organic drift.</system:String>
    <system:String x:Key="TrackInspector_W">W=</system:String>
    <system:String x:Key="TrackInspector_Wave">Wave</system:String>
    <system:String x:Key="TrackInspector_none">(none)</system:String>
    <system:String x:Key="TrackInspector_none_Placeholder">(none)</system:String>
    <system:String x:Key="TransportAction_PlayPause">Play / Pause</system:String>
    <system:String x:Key="TransportAction_Record">Record</system:String>
    <system:String x:Key="TransportAction_Stop">Stop</system:String>
    <system:String x:Key="Transport_Add_arrangement_marker_at_playhead_Tip">Add arrangement marker at playhead</system:String>
    <system:String x:Key="Transport_Adjust_master_output_level">Adjust master output level</system:String>
    <system:String x:Key="Transport_Adjust_master_output_level_A11yHelp">Adjust master output level</system:String>
