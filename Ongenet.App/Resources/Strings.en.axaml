    <system:String x:Key="Timeline_Mute_Tip">Mute</system:String>
    <system:String x:Key="Timeline_New_audio_track">New audio track</system:String>
    <system:String x:Key="Timeline_Open_in_Audio_Editor">Open in Audio Editor</system:String>
    <system:String x:Key="Timeline_Open_Pitch_Editor">Open Pitch Editor</system:String>
    <system:String x:Key="Timeline_Open_ARA_Editor">Open ARA Editor</system:String>
    <system:String x:Key="Timeline_PATTERN">PATTERN</system:String>
    <system:String x:Key="Timeline_Promote_take">Promote take</system:String>
    <system:String x:Key="Timeline_Remove_automation_Tip">Remove automation</system:String>
