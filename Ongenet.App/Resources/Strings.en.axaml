    <system:String x:Key="Field_Field">Field</system:String>
    <system:String x:Key="Field_Field_Title">Field</system:String>
    <system:String x:Key="FileBrowser_Text">📁</system:String>
    <system:String x:Key="FileBrowser_Text_2">🎵</system:String>
    <system:String x:Key="Groove_Adjust_how_strong_the_selected_grooves_swing_is__Tip">Adjust how strong the selected groove's swing is. Subtle changes (52–58%) often sound most natural on drums and bass.</system:String>
    <system:String x:Key="Groove_Analyze_timing_in_the_selected_MIDI_clip_and_sav_Tip">Analyze timing in the selected MIDI clip and save it as a new groove template — capture a drummer's or player's feel and apply it to other parts.</system:String>
    <system:String x:Key="Groove_Drum_map_editor">Drum map editor…</system:String>
    <system:String x:Key="Groove_Enable_MPE">Enable MPE</system:String>
    <system:String x:Key="Groove_Extract_from_clip">Extract from clip</system:String>
    <system:String x:Key="Groove_First_member_channel_each_playing_note_is_assign_Tip">First member channel — each playing note is assigned the next free channel from here upward for its own pitch bend and pressure.</system:String>
    <system:String x:Key="Groove_GROOVE">GROOVE</system:String>
    <system:String x:Key="Groove_Groove_applies_humanized_timing_and_swing_to_MID_Tip">Groove applies humanized timing and swing to MIDI on this track — shifts off-beat notes late or early based on a template so programmed parts feel less rigid.</system:String>
    <system:String x:Key="Groove_How_many_MIDI_channels_are_reserved_for_simultan_Tip">How many MIDI channels are reserved for simultaneous notes — limits polyphony of independent expression (e.g. 15 = up to 15 notes with individual bend at once).</system:String>
    <system:String x:Key="Groove_How_many_drum_maps_are_saved_in_this_project_Map_Tip">How many drum maps are saved in this project. Maps are shared — assign them on instrument tracks under DRUM MAP.</system:String>
    <system:String x:Key="Groove_Import_a_groove_template_file_into_the_project_p_Tip">Import a groove template file into the project pool so it can be assigned to any track. Use this to reuse swing/timing feels from other sessions or libraries.</system:String>
    <system:String x:Key="Groove_Import_groove">Import groove…</system:String>
    <system:String x:Key="Groove_Lowest_channel_number_used_for_per_note_expressi_Tip">Lowest channel number used for per-note expression. Must leave room for Member count channels below 16.</system:String>
    <system:String x:Key="Groove_MPE">MPE</system:String>
    <system:String x:Key="Groove_MPE_MIDI_Polyphonic_Expression_sends_per_note_pi_Tip">MPE (MIDI Polyphonic Expression) sends per-note pitch bend, pressure, and timbre on separate channels — required for expressive controllers like Roli Seaboard and many modern synths.</system:String>
    <system:String x:Key="Groove_MPE_master_channel_carries_shared_messages_like__Tip">MPE master channel — carries shared messages like sustain pedal and global pitch bend that apply to all notes.</system:String>
    <system:String x:Key="Groove_Master_ch">Master ch</system:String>
    <system:String x:Key="Groove_Member_count">Member count</system:String>
    <system:String x:Key="Groove_Member_start">Member start</system:String>
    <system:String x:Key="Groove_No_groove">No groove</system:String>
    <system:String x:Key="Groove_No_groove_Placeholder">No groove</system:String>
    <system:String x:Key="Groove_Number_of_consecutive_member_channels_More_chann_Tip">Number of consecutive member channels. More channels = more simultaneous expressive notes; fewer saves channels for other tracks.</system:String>
    <system:String x:Key="Groove_Open_the_drum_map_editor_to_name_MIDI_notes_Kick_Tip">Open the drum map editor to name MIDI notes (Kick, Snare, etc.) and organize drum kits for piano roll and notation display.</system:String>
    <system:String x:Key="Groove_Pick_a_groove_template_from_the_project_pool_Gro_Tip">Pick a groove template from the project pool. Grooves nudge note timing per beat; choose No groove for straight quantization. Import or extract templates below.</system:String>
    <system:String x:Key="Groove_Set_the_master_MIDI_channel_usually_1_Member_cha_Tip">Set the master MIDI channel (usually 1). Member channels for individual notes must not overlap this channel.</system:String>
    <system:String x:Key="Groove_Swing_amount">Swing amount</system:String>
    <system:String x:Key="Groove_Swing_delays_off_beat_notes_50_is_straight_no_sw_Tip">Swing delays off-beat notes — 50% is straight (no swing); higher values (e.g. 60–66%) give a laid-back shuffle common in hip-hop and house.</system:String>
    <system:String x:Key="Groove_Turn_on_MPE_routing_for_this_track_When_enabled__Tip">Turn on MPE routing for this track. When enabled, each note can have independent bend and pressure; disable for standard single-channel MIDI instruments.</system:String>
    <system:String x:Key="Guide_Close_Tip">Close</system:String>
