<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Ongenet.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        x:Class="Ongenet.App.Views.Windows.GuideWindow"
        x:DataType="vm:GuideViewModel"
        Width="720" Height="520" MinWidth="480" MinHeight="360"
        Title="{DynamicResource Guide_Guide_Title}"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Styles>
        <Style Selector="Button.GuideLink">
            <Setter Property="Foreground" Value="{StaticResource CatppuccinSapphire}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.GuideLink:pointerover">
            <Setter Property="Foreground" Value="{StaticResource CatppuccinBlue}"/>
        </Style>
        <Style Selector="Button.GuideLink /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Border Name="RootBorder" Background="{StaticResource CatppuccinBase}"
                BorderBrush="{StaticResource CatppuccinBase}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" Name="TitleBar" Classes="TitleBar" ColumnDefinitions="Auto, *, Auto"
                      PointerPressed="TitleBar_PointerPressed">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Name="MacWindowButtons" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Margin="14,0,8,0" IsVisible="False">
                            <Button Classes="MacButton" Background="{StaticResource CatppuccinRed}"
                                    Click="CloseButton_Click" ToolTip.Tip="{DynamicResource Guide_Close_Tip}">
                                <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="#80000000" StrokeThickness="1.2" Opacity="0"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Guide_Guide}" Margin="10,0" FontSize="12"
                                   Foreground="{StaticResource CatppuccinOverlay2}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Name="StandardWindowButtons" Grid.Column="2" Orientation="Horizontal">
                        <Button Name="CloseButton" Classes="TitleBarButton Close" Click="CloseButton_Click">
                            <Path VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="200, *" Margin="12">
                    <ListBox Grid.Column="0" ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Background="{StaticResource CatppuccinSurface0}"
                             BorderBrush="{StaticResource CatppuccinSurface2}" BorderThickness="1"
                             CornerRadius="4" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuideSectionViewModel">
                                <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource CatppuccinText}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Column="1" Margin="12,0,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Selected.Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource CatppuccinText}"/>
                            <TextBlock Text="{Binding Selected.Body}" TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <TextBlock Text="{Binding Selected.LinksHeading}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource CatppuccinText}"
                                       IsVisible="{Binding Selected.HasLinks}"/>
                            <ItemsControl ItemsSource="{Binding Selected.Links}"
                                          IsVisible="{Binding Selected.HasLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GuideLink">
                                        <Button Classes="GuideLink" Content="{Binding Label}"
                                                Tag="{Binding Url}" Click="OpenLink_Click"
                                                HorizontalAlignment="Left" Margin="0,2,0,0"
                                                Padding="0" Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Panel>
</Window>
