<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inst="using:Ongenet.App.ViewModels.Instruments"
             xmlns:panels="using:Ongenet.App.Views.Panels"
             xmlns:controls="using:Ongenet.App.Controls"
             xmlns:field="using:Ongenet.App.Views.Field"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="260"
             x:Class="Ongenet.App.Views.Panels.InstrumentSlotView"
             x:DataType="inst:InstrumentSlotViewModel">

    <UserControl.Styles>
        <Style Selector="Button.fxdot">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Name="CardRoot" Margin="0,0,0,8" Padding="10" CornerRadius="4"
            DragDrop.AllowDrop="True"
            Background="{StaticResource CatppuccinSurface0}"
            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
        <Grid>
        <StackPanel Spacing="6">

            <!-- Header: enable dot, name, specialised loaders/plugin UI, reorder + remove -->
            <DockPanel>
                <Button DockPanel.Dock="Left" Classes="fxdot" Margin="0,0,8,0"
                        Command="{Binding ToggleEnabledCommand}"
                        ToolTip.Tip="{DynamicResource InstrumentSlot_Enable_disable_instrument_Tip}">
                    <Panel>
                        <Ellipse Width="12" Height="12" IsVisible="{Binding IsEnabled}"
                                 Fill="{StaticResource CatppuccinGreen}"/>
                        <Ellipse Width="12" Height="12" IsVisible="{Binding !IsEnabled}"
                                 Fill="{StaticResource CatppuccinRed}"/>
                    </Panel>
                </Button>

                <Button DockPanel.Dock="Right" Content="{DynamicResource InstrumentSlot_Text}" Command="{Binding RemoveCommand}"
 Padding="6,0"
                        ToolTip.Tip="{DynamicResource InstrumentSlot_Remove_instrument_Tip}"/>
                <Button DockPanel.Dock="Right" Content="▼" Command="{Binding MoveDownCommand}"
                        IsEnabled="{Binding !IsLast}"                        Padding="6,0" Margin="2,0"/>
                <Button DockPanel.Dock="Right" Content="▲" Command="{Binding MoveUpCommand}"
                        IsEnabled="{Binding !IsFirst}"                        Padding="6,0" Margin="2,0"/>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding InstrumentName}" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{StaticResource CatppuccinMauve}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0"
                                VerticalAlignment="Center" IsVisible="{Binding IsPresetProvider}">
                        <TextBlock Text="{DynamicResource InstrumentSlot_Preset}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <ComboBox Classes="stretch" MinWidth="150" ItemsSource="{Binding PresetNames}"
                                  SelectedIndex="{Binding SelectedPreset}"
                                  PlaceholderText="{DynamicResource InstrumentSlot_Choose_a_preset}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0"
                                VerticalAlignment="Center" IsVisible="{Binding IsSampler}">
                        <Button Content="{DynamicResource InstrumentSlot_Load_sample}" Click="OnLoadSample"
/>
                        <TextBlock Text="{Binding SampleName}" VerticalAlignment="Center"
                                   MaxWidth="220" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0"
                                VerticalAlignment="Center" IsVisible="{Binding IsSoundFont}">
                        <Button Content="{DynamicResource InstrumentSlot_Editor}" Command="{Binding OpenZoneEditorCommand}"
                                ToolTip.Tip="{DynamicResource InstrumentSlot_Open_sampler_editor_Tip}"
/>
                        <Button Content="{DynamicResource InstrumentSlot_Load}" Click="OnLoadSampler"
                                ToolTip.Tip="{DynamicResource InstrumentSlot_Load_an_SFZ_patch_or_SF2_SoundFont_Tip}"
/>
                        <Button Content="{DynamicResource InstrumentSlot_Add_layer}" Click="OnAddSamplerLayer"
                                ToolTip.Tip="{DynamicResource InstrumentSlot_Add_layer_Tip}"
/>
                        <ComboBox Classes="stretch" MinWidth="180" MaxWidth="240" VerticalAlignment="Center"
                                  IsVisible="{Binding HasSamplerPresets}"
                                  ItemsSource="{Binding SamplerPresetNames}"
                                  SelectedIndex="{Binding SelectedSamplerPreset, Mode=TwoWay}"
                                  ToolTip.Tip="{DynamicResource InstrumentSlot_Select_an_SF2_preset_Tip}"/>
                        <TextBlock Text="{Binding SamplerStatus}" VerticalAlignment="Center"
                                   MaxWidth="260" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <ProgressBar Width="120" Height="6" Minimum="0" Maximum="1"
                                     Value="{Binding SamplerLoadProgress}" IsVisible="{Binding IsSamplerLoading}"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource CatppuccinMauve}"/>
                    </StackPanel>

                    <Button Content="{Binding EditorButtonText}" Click="OnTogglePluginUi"
                            IsVisible="{Binding HasEditor}" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource InstrumentSlot_Open_the_plugins_own_interface_Tip}"/>

                    <Button Name="SavePresetButton" Content="{DynamicResource InstrumentSlot_Save_preset}" VerticalAlignment="Center"
                            Margin="8,0,0,0"                            ToolTip.Tip="{DynamicResource InstrumentSlot_Save_this_instruments_settings_as_a_preset_Tip}">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="200" Spacing="6">
                                    <TextBlock Text="{DynamicResource InstrumentSlot_Preset_name}" FontSize="11"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <TextBox Text="{Binding PresetName, Mode=TwoWay}" PlaceholderText="{Binding InstrumentName}"/>
                                    <Button Content="{DynamicResource InstrumentSlot_Save}" Click="OnSavePreset" HorizontalAlignment="Right"
/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>
            </DockPanel>

            <!-- Parameters -->
            <panels:GroupedParametersView DataContext="{Binding ParameterGroups}"/>

            <!-- Field: the full modular node-graph editor embedded in the instrument card. -->
            <Border CornerRadius="4" ClipToBounds="True" IsVisible="{Binding IsField}" Height="420"
                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                <field:FieldEditorView DataContext="{Binding FieldEditor}"/>
            </Border>

            <!-- Wavetable synth: a fixed-width 3D table view next to its controls (not the full panel width). -->
            <Border CornerRadius="4" ClipToBounds="True" IsVisible="{Binding IsWavetable}" Height="220"
                    Background="{StaticResource CatppuccinCrust}"
                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                <Grid ColumnDefinitions="360,*">
                    <Border Grid.Column="0" BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="0,0,1,0">
                        <controls:Engine3DVisualHost VisualizationFactory="{Binding WavetableVisualizationFactory}"
                                                     Title="{DynamicResource InstrumentSlot_Wavetable_Title}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,12" Spacing="9" VerticalAlignment="Top">
                        <TextBlock Text="{DynamicResource InstrumentSlot_WAVETABLE}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource CatppuccinOverlay1}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CatppuccinSubtext0}"
                                   Text="{DynamicResource InstrumentSlot_Sweep_with_Position_assign_the_LFO_to_it_for_mov}"/>
                        <Button Content="{DynamicResource InstrumentSlot_Basic_morph}" Command="{Binding WavetableBasicCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6"
                                ToolTip.Tip="{DynamicResource InstrumentSlot_Sine_triangle_saw_square_across_the_scan_Tip}"/>
                        <Button Content="{DynamicResource InstrumentSlot_Harmonics}" Command="{Binding WavetableHarmonicsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6"
                                ToolTip.Tip="{DynamicResource InstrumentSlot_Sine_gaining_harmonics_into_a_full_sawtooth_Tip}"/>
                        <Button Content="{DynamicResource InstrumentSlot_Random}" Command="{Binding WavetableRandomCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6"
                                ToolTip.Tip="{DynamicResource InstrumentSlot_A_fresh_evolving_random_spectrum_table_Tip}"/>
                        <TextBlock Text="{Binding SampleName, StringFormat='Table: {0}'}" FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource CatppuccinOverlay1}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grain monitor (granular synth only) -->
            <Border Height="96" CornerRadius="4" ClipToBounds="True" IsVisible="{Binding IsGranular}"
                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                <Grid>
                    <controls:GrainMonitorControl Monitor="{Binding GrainMonitor}"/>
                    <TextBlock Text="{DynamicResource InstrumentSlot_GRAINS}" FontSize="9" Margin="6,4"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               IsHitTestVisible="False"
                               Foreground="{StaticResource CatppuccinOverlay1}"/>
                </Grid>
            </Border>

            <!-- Waveform preview (instruments that render a one-shot, e.g. Kicka) -->
            <Border Height="96" CornerRadius="4" ClipToBounds="True" IsVisible="{Binding IsPreviewable}"
                    Background="{StaticResource CatppuccinCrust}"
                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                <Grid>
                    <controls:WaveformControl Waveform="{Binding InstrumentPreview}"
                                              Revision="{Binding PreviewRevision}"
                                              Fill="{StaticResource CatppuccinMauve}"/>
                    <TextBlock Text="{DynamicResource InstrumentSlot_WAVEFORM}" FontSize="9" Margin="6,4"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               IsHitTestVisible="False"
                               Foreground="{StaticResource CatppuccinOverlay1}"/>
                </Grid>
            </Border>

            <!-- "Sampler" (SFZ / SF2): zone map + amp envelope + live controllers -->
            <Border Height="150" CornerRadius="4" ClipToBounds="True" IsVisible="{Binding IsSoundFont}"
                    Background="{StaticResource CatppuccinCrust}"
                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                <Grid ColumnDefinitions="*,220">
                    <Grid Grid.Column="0">
                        <controls:ZoneMapControl Zones="{Binding SamplerZones}" Revision="{Binding SamplerRevision}"/>
                        <TextBlock Text="{DynamicResource InstrumentSlot_ZONES_key_velocity}" FontSize="9" Margin="6,4"
                                   VerticalAlignment="Top" HorizontalAlignment="Left"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource CatppuccinOverlay1}"/>
                    </Grid>

                    <DockPanel Grid.Column="1" Margin="8,4,6,6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource InstrumentSlot_AMP_ENVELOPE}" FontSize="9"
                                   Foreground="{StaticResource CatppuccinOverlay1}"/>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,6,0,0">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="{DynamicResource InstrumentSlot_Mod}" FontSize="10"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                                <Slider Minimum="0" Maximum="127" Value="{Binding ModWheel, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="{DynamicResource InstrumentSlot_Bend}" FontSize="10"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                                <Slider Minimum="0" Maximum="16383" Value="{Binding PitchBendValue, Mode=TwoWay}"
                                        PointerReleased="OnBendReleased" PointerCaptureLost="OnBendCaptureLost"/>
                            </StackPanel>
                        </Grid>
                        <controls:EnvelopeDisplayControl MinHeight="40"
                            Delay="{Binding EnvDelay}" Attack="{Binding EnvAttack}"
                            Hold="{Binding EnvHold}" Decay="{Binding EnvDecay}"
                            Sustain="{Binding EnvSustain}" Release="{Binding EnvRelease}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- This instrument's own (pre) effect chain -->
            <Expander Header="{DynamicResource InstrumentSlot_Instrument_FX_pre}" Margin="0,2,0,0">
                <panels:EffectChainView DataContext="{Binding Effects}" Margin="0,6,0,0"/>
            </Expander>

            <Expander Header="{DynamicResource InstrumentSlot_Multi_out_routing}" Margin="0,2,0,0">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource InstrumentSlot_Plugin_output_bus}" FontSize="11"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <NumericUpDown Value="{Binding OutputBusIndex, Mode=TwoWay}"
                                       Minimum="0" Maximum="15" Increment="1" FormatString="0"
                                       ToolTip.Tip="{DynamicResource InstrumentSlot_N0_default_stereo_mix_higher_indices_for_multi_o_Tip}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource InstrumentSlot_Route_to_track}" FontSize="11"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <ComboBox Classes="stretch" ItemsSource="{Binding OutputRouteOptions}"
                                  SelectedItem="{Binding SelectedOutputTrack, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="inst:OutputRouteOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Drag-drop indicators (instrument from the library): replace-fill or insert line above/below -->
        <Border Name="DropReplace" IsVisible="False" IsHitTestVisible="False" CornerRadius="4"
                Background="#33CBA6F7" BorderBrush="{StaticResource CatppuccinMauve}" BorderThickness="2"/>
        <Rectangle Name="DropLineTop" IsVisible="False" IsHitTestVisible="False" Height="3"
                   VerticalAlignment="Top" Fill="{StaticResource CatppuccinMauve}"/>
        <Rectangle Name="DropLineBottom" IsVisible="False" IsHitTestVisible="False" Height="3"
                   VerticalAlignment="Bottom" Fill="{StaticResource CatppuccinMauve}"/>
        </Grid>
    </Border>
</UserControl>
