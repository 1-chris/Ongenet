<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ongenet.App.ViewModels.Panels"
             xmlns:controls="using:Ongenet.App.Controls"
             x:Class="Ongenet.App.Views.Panels.NotationView"
             x:DataType="vm:NotationViewModel">
    <Grid RowDefinitions="Auto,*" Background="{StaticResource CatppuccinBase}">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8" Spacing="8">
            <TextBlock Text="{DynamicResource Notation_Notation}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource CatppuccinText}" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource Notation_Import_MusicXML}" Command="{Binding ImportMusicXmlCommand}" Padding="10,4" FontSize="11"/>
            <Button Content="{DynamicResource Notation_Export_MusicXML}" Command="{Binding ExportMusicXmlCommand}" Padding="10,4" FontSize="11"/>
            <Button Content="{DynamicResource Notation_Export_PDF}" Command="{Binding ExportPdfCommand}" Padding="10,4" FontSize="11"/>
            <Button Content="{DynamicResource Notation_N1}" Command="{Binding TransposeUpCommand}" Padding="8,4" FontSize="11"
                    ToolTip.Tip="{DynamicResource Notation_Transpose_displayed_score_up_one_semitone_Tip}"/>
            <Button Content="{DynamicResource Notation_N1_2}" Command="{Binding TransposeDownCommand}" Padding="8,4" FontSize="11"
                    ToolTip.Tip="{DynamicResource Notation_Transpose_displayed_score_down_one_semitone_Tip}"/>
            <Button Content="{DynamicResource Notation_Apply_to_project}" Command="{Binding ApplyToProjectCommand}" Padding="10,4" FontSize="11"
                    ToolTip.Tip="{DynamicResource Notation_Write_edited_score_notes_back_to_MIDI_clips_Tip}"/>
            <ComboBox ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding LayoutMode}"
                      Width="120" FontSize="11" VerticalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Notation_Lead_sheet_chord_focused_or_full_score_layout_Tip}"/>
            <ComboBox ItemsSource="{Binding Articulations}" SelectedItem="{Binding SelectedArticulation}"
                      Width="100" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource Notation_Art}" Command="{Binding ApplyArticulationCommand}" Padding="6,4" FontSize="11"
                    ToolTip.Tip="{DynamicResource Notation_Apply_articulation_at_playhead_Tip}"/>
            <ComboBox ItemsSource="{Binding Dynamics}" SelectedItem="{Binding SelectedDynamic}"
                      Width="80" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource Notation_Dyn}" Command="{Binding ApplyDynamicCommand}" Padding="6,4" FontSize="11"
                    ToolTip.Tip="{DynamicResource Notation_Apply_dynamic_at_playhead_Tip}"/>
            <Button Content="{DynamicResource Notation_Tuplet}" Command="{Binding AddTupletCommand}" Padding="8,4" FontSize="11"
                    ToolTip.Tip="{DynamicResource Notation_Add_triplet_grouping_at_playhead_Tip}"/>
            <TextBlock Text="{Binding TupletCount, StringFormat='{}{0} tuplets'}"
                       VerticalAlignment="Center" FontSize="11"
                       IsVisible="{Binding HasScore}"
                       Foreground="{StaticResource CatppuccinOverlay1}"/>
            <TextBlock Text="{Binding TransposeSemitones, StringFormat='Transposed {0:+0;-0;0} st'}"
                       VerticalAlignment="Center" FontSize="11"
                       IsVisible="{Binding HasScore}"
                       Foreground="{StaticResource CatppuccinOverlay1}"/>
            <TextBlock Text="{DynamicResource Notation_No_MIDI_clips_to_display}" VerticalAlignment="Center" FontSize="11"
                       IsVisible="{Binding !HasScore}"
                       Foreground="{StaticResource CatppuccinOverlay1}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <controls:StaffControl x:Name="Staff" Document="{Binding Score}" PixelsPerBeat="{Binding PixelsPerBeat}"
                                   MinWidth="800" MinHeight="400" Margin="8"/>
        </ScrollViewer>
    </Grid>
</UserControl>
