<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ongenet.App.ViewModels.VideoTimeline"
             xmlns:tl="using:Ongenet.App.ViewModels.Timeline"
             xmlns:media="using:Ongenet.Core.Models.Media"
             xmlns:panels="using:Ongenet.App.ViewModels.Panels"
             x:Class="Ongenet.App.Views.Panels.VideoTimelineView"
             x:DataType="vm:VideoTimelineViewModel">
    <UserControl.Resources>
        <x:Double x:Key="HeaderWidth">140</x:Double>
        <x:Double x:Key="RulerHeight">22</x:Double>
        <x:Double x:Key="RefLaneHeight">40</x:Double>
        <x:Double x:Key="VideoInspectorLabelWidth">72</x:Double>
        <x:Double x:Key="VideoInspectorFieldWidth">116</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.video-vis-block">
            <Setter Property="Background" Value="{StaticResource CatppuccinTeal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="Border.video-vis-block.selected">
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinYellow}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.video-layer-header">
            <Setter Property="Background" Value="{StaticResource CatppuccinMantle}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
        <Style Selector="Border.video-layer-header.selected">
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinSapphire}"/>
        </Style>
        <Style Selector="Border.video-layer-header.selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CatppuccinText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.video-overlay-lane">
            <Setter Property="Background" Value="{StaticResource CatppuccinCrust}"/>
        </Style>
        <Style Selector="Border.video-overlay-lane.selected">
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource CatppuccinCrust}">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,4">
                <TextBlock Text="{DynamicResource VideoTimeline_Title}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CatppuccinSubtext0}" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource VideoResources_Add_layer}" Command="{Binding AddLayerCommand}"
                        Padding="6,2" FontSize="10"/>
                <Button Content="{DynamicResource VideoTimeline_Add_region}" Command="{Binding AddVisibilityRegionCommand}"
                        Padding="6,2" FontSize="10"/>
                <Button Content="{DynamicResource VideoTimeline_Import_markers}" Command="{Binding ImportMarkersAsTriggersCommand}"
                        Padding="6,2" FontSize="10"/>
            </StackPanel>

            <Grid Grid.Row="1" Name="ContentGrid" ColumnDefinitions="*,4,340">
                <Grid Grid.Column="0" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
                <Border Grid.Row="0" Grid.Column="0" Width="{StaticResource HeaderWidth}" Height="{StaticResource RulerHeight}"
                        Background="{StaticResource CatppuccinMantle}"/>
                <ScrollViewer Grid.Row="0" Grid.Column="1" Name="RulerScroll"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Background="{StaticResource CatppuccinMantle}">
                    <ItemsControl ItemsSource="{Binding Bars}" HorizontalAlignment="Left"
                                  Width="{Binding Metrics.TotalWidth}" Height="{StaticResource RulerHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="tl:BarTickViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tl:BarTickViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4" Height="22"
                                            IsVisible="{Binding IsLabelVisible}">
                                    <Rectangle Width="1" Fill="{StaticResource CatppuccinSurface2}"/>
                                    <TextBlock Text="{Binding BarNumber}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" Grid.Column="0" Name="HeaderScroll"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource CatppuccinMantle}">
                    <ItemsControl ItemsSource="{Binding OverlayLanes}" Width="{StaticResource HeaderWidth}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VideoOverlayLaneViewModel">
                                <Border Height="{Binding LaneHeight}" Padding="6,0"
                                        Classes="video-layer-header"
                                        Classes.selected="{Binding IsSelected}"
                                        PointerPressed="OverlayHeader_PointerPressed"
                                        PointerMoved="OverlayHeader_PointerMoved"
                                        PointerReleased="OverlayHeader_PointerReleased">
                                    <TextBlock Text="{Binding Header}" FontSize="10" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" Grid.Column="1" Name="LanesScroll"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource CatppuccinBase}">
                    <Grid Width="{Binding Metrics.TotalWidth}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding OverlayLanes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VideoOverlayLaneViewModel">
                                        <Border Height="{Binding LaneHeight}"
                                                Classes="video-overlay-lane"
                                                Classes.selected="{Binding IsSelected}"
                                                PointerPressed="OverlayLane_PointerPressed"
                                                DoubleTapped="OverlayLane_DoubleTapped">
                                            <Canvas Height="{Binding LaneHeight}">
                                                <TextBlock Canvas.Top="10" Canvas.Left="8" FontSize="10"
                                                           Foreground="{StaticResource CatppuccinOverlay0}"
                                                           Text="{DynamicResource VideoTimeline_Lane_visibility_hint}"
                                                           IsVisible="{Binding ShowVisibilityHint}"
                                                           IsHitTestVisible="False"/>
                                                <ItemsControl ItemsSource="{Binding VisibilityBlocks}"
                                                              Width="{Binding Metrics.TotalWidth}"
                                                              Height="{Binding LaneHeight}"
                                                              Canvas.Left="0" Canvas.Top="0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerTheme>
                                                        <ControlTheme TargetType="ContentPresenter" x:DataType="vm:VideoVisibilityBlockViewModel">
                                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                            <Setter Property="Canvas.Top" Value="6"/>
                                                            <Setter Property="Width" Value="{Binding Width}"/>
                                                            <Setter Property="Height" Value="24"/>
                                                        </ControlTheme>
                                                    </ItemsControl.ItemContainerTheme>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:VideoVisibilityBlockViewModel">
                                                            <Border Classes="video-vis-block"
                                                                    Classes.selected="{Binding IsSelected}"
                                                                    ToolTip.Tip="{DynamicResource VideoTimeline_Region_move}"
                                                                    ContextRequested="VisibilityBlock_ContextRequested"
                                                                    PointerPressed="VisibilityBlock_PointerPressed"
                                                                    PointerMoved="VisibilityBlock_PointerMoved">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="{DynamicResource Timeline_Duplicate}"
                                                                                  Tag="{Binding}"
                                                                                  Click="VisibilityBlockDuplicate_Click"/>
                                                                        <MenuItem Header="{DynamicResource Timeline_Delete}"
                                                                                  Tag="{Binding}"
                                                                                  Click="VisibilityBlockDelete_Click"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Markers}"
                                                              Width="{Binding Metrics.TotalWidth}"
                                                              Height="{Binding LaneHeight}"
                                                              Canvas.Left="0" Canvas.Top="0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.Styles>
                                                        <Style Selector="ContentPresenter" x:DataType="vm:VideoTriggerMarkerViewModel">
                                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                            <Setter Property="Canvas.Top" Value="12"/>
                                                        </Style>
                                                    </ItemsControl.Styles>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:VideoTriggerMarkerViewModel">
                                                            <Border Width="10" Height="10" Background="{StaticResource CatppuccinPeach}"
                                                                    RenderTransformOrigin="0.5,0.5"
                                                                    RenderTransform="rotate(45)"
                                                                    ToolTip.Tip="{Binding Label}"
                                                                    PointerPressed="Marker_PointerPressed"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Name="PlayheadLine" Width="2" Fill="{StaticResource CatppuccinRed}" Opacity="0.9"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
                </Grid>

                <GridSplitter Grid.Column="1" Name="InspectorSplitter" ResizeDirection="Columns"
                              Background="{StaticResource CatppuccinSurface1}"
                              IsVisible="{Binding ShowInspectorPanel}"/>

                <Border Grid.Column="2" Background="{StaticResource CatppuccinMantle}"
                        BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1,0,0,0"
                        ClipToBounds="True" MinWidth="260" MaxWidth="520"
                        IsVisible="{Binding ShowInspectorPanel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,8,4,8">
                        <StackPanel Spacing="8" MinWidth="240">
                    <TextBlock Text="{DynamicResource VideoTimeline_Inspector_empty}" FontSize="11"
                               Foreground="{StaticResource CatppuccinOverlay1}" TextWrapping="Wrap"
                               IsVisible="{Binding ShowInspectorPlaceholder}"/>

                    <StackPanel Spacing="6" IsVisible="{Binding SelectedLayer, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{DynamicResource VideoTimeline_Inspector_layer}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoTrack_Name}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedLayerName, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource VideoTrack_Name}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VideoTrack_Content}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LayerContentKindOptions}"
                                      SelectedItem="{Binding SelectedLayerContentKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3"
                                        IsVisible="{Binding ShowLayerMediaInspector}">
                                <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoTimeline_Items}" FontSize="11"
                                               VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <ListBox ItemsSource="{Binding SelectedLayerItems}" SelectedItem="{Binding SelectedLayerItem, Mode=TwoWay}"
                                                 MinHeight="60" MaxHeight="120">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="media:VideoLayerItem">
                                                    <TextBlock Text="{Binding SourcePath}" FontSize="10"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="{DynamicResource VideoTimeline_Add_item}" Command="{Binding AddLayerItemCommand}" Padding="6,3" FontSize="10"/>
                                            <Button Content="−" Command="{Binding RemoveLayerItemCommand}" Padding="6,3" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VideoTrack_Overlay_type}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ElementKindOptions}"
                                              SelectedItem="{Binding SelectedLayerItemKind, Mode=TwoWay}"
                                              PlaceholderText="{DynamicResource VideoTrack_Overlay_type}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="2" Grid.Column="1" Content="{DynamicResource VideoTrack_Browse}"
                                            Command="{Binding BrowseLayerItemCommand}" HorizontalAlignment="Left" Padding="8,4"
                                            IsVisible="{Binding ShowLayerItemMediaPath}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource VideoTrack_Text_content}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemTextInspector}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LayerItemTextContent, Mode=TwoWay}"
                                             IsVisible="{Binding ShowLayerItemTextInspector}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoTrack_Text_size}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemTextInspector}"/>
                                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding LayerItemFontSizePx, Mode=TwoWay}"
                                                   Minimum="8" Maximum="256" Increment="2" FormatString="0"
                                                   IsVisible="{Binding ShowLayerItemTextInspector}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource VideoTrack_Text_color}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemTextInspector}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding WaveformColorPresets}"
                                              SelectedItem="{Binding SelectedLayerItemTextColor, Mode=TwoWay}"
                                              IsVisible="{Binding ShowLayerItemTextInspector}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WaveformColorPreset">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource VideoTrack_Subtitle_srt}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemSubtitleInspector}"/>
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding ShowLayerItemSubtitleInspector}">
                                        <TextBox Text="{Binding LayerItemSubtitleSrtPath, Mode=TwoWay}" MinWidth="120"/>
                                        <Button Content="{DynamicResource VideoTrack_Browse}" Command="{Binding BrowseSubtitleSrtCommand}" Padding="6,3"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource VideoTrack_Rotation}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemInspector}"/>
                                    <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding LayerItemRotation, Mode=TwoWay}"
                                                   Minimum="-360" Maximum="360" Increment="1" FormatString="0"
                                                   IsVisible="{Binding ShowLayerItemInspector}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource VideoTrack_Opacity}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemInspector}"/>
                                    <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding LayerItemOpacity, Mode=TwoWay}"
                                                   Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                                   IsVisible="{Binding ShowLayerItemInspector}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource VideoTrack_Chroma_key}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <CheckBox Grid.Row="9" Grid.Column="1" Content="{DynamicResource VideoTrack_Chroma_key_enable}"
                                              IsChecked="{Binding LayerItemChromaKeyEnabled, Mode=TwoWay}"
                                              IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource VideoTrack_Chroma_tolerance}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <NumericUpDown Grid.Row="10" Grid.Column="1" Value="{Binding LayerItemChromaKeyTolerance, Mode=TwoWay}"
                                                   Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                                   IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <Button Grid.Row="11" Grid.Column="1" Content="{DynamicResource VideoTrack_Add_keyframe}"
                                            Command="{Binding AddKeyframeAtPlayheadCommand}" HorizontalAlignment="Left" Padding="8,4"
                                            IsVisible="{Binding ShowLayerItemInspector}"/>
                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="{DynamicResource VideoTrack_Blend_mode}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <ComboBox Grid.Row="12" Grid.Column="1" ItemsSource="{Binding BlendModeOptions}"
                                              SelectedItem="{Binding SelectedLayerBlendMode, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="13" Grid.Column="0" Text="{DynamicResource VideoTrack_Brightness}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <NumericUpDown Grid.Row="13" Grid.Column="1" Value="{Binding LayerItemBrightness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="2" Increment="0.05" FormatString="F2"
                                                   IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <TextBlock Grid.Row="14" Grid.Column="0" Text="{DynamicResource VideoTrack_Contrast}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <NumericUpDown Grid.Row="14" Grid.Column="1" Value="{Binding LayerItemContrast, Mode=TwoWay}"
                                                   Minimum="0" Maximum="2" Increment="0.05" FormatString="F2"
                                                   IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <TextBlock Grid.Row="15" Grid.Column="0" Text="{DynamicResource VideoTrack_Saturation}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <NumericUpDown Grid.Row="15" Grid.Column="1" Value="{Binding LayerItemSaturation, Mode=TwoWay}"
                                                   Minimum="0" Maximum="2" Increment="0.05" FormatString="F2"
                                                   IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <TextBlock Grid.Row="16" Grid.Column="0" Text="{DynamicResource VideoTrack_Lut_cube}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding ShowLayerItemEffectsInspector}">
                                        <TextBox Text="{Binding LayerItemLutCubePath, Mode=TwoWay}" MinWidth="120"/>
                                        <Button Content="{DynamicResource VideoTrack_Browse}" Command="{Binding BrowseLutCubeCommand}" Padding="6,3"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="17" Grid.Column="0" Text="{DynamicResource VideoTrack_Mask_image}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemEffectsInspector}"/>
                                    <StackPanel Grid.Row="17" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding ShowLayerItemEffectsInspector}">
                                        <TextBox Text="{Binding LayerItemMaskImagePath, Mode=TwoWay}" MinWidth="120"/>
                                        <Button Content="{DynamicResource VideoTrack_Browse}" Command="{Binding BrowseMaskImageCommand}" Padding="6,3"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="18" Grid.Column="0" Text="{DynamicResource VideoTrack_Generate_proxy}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowLayerItemProxyInspector}"/>
                                    <StackPanel Grid.Row="18" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding ShowLayerItemProxyInspector}">
                                        <Button Content="{DynamicResource VideoTrack_Generate_proxy}" Command="{Binding GenerateProxyCommand}" Padding="8,4"/>
                                        <TextBlock Text="{Binding ProxyCacheStatus}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    </StackPanel>
                                    <Button Grid.Row="19" Grid.Column="1" Content="{DynamicResource VideoTrack_Capture_3d_snapshot}"
                                            Command="{Binding CaptureEngine3DSnapshotCommand}" HorizontalAlignment="Left" Padding="8,4"
                                            IsVisible="{Binding ShowEngine3DCapture}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3"
                                        IsVisible="{Binding ShowLayerWaveformInspector}" Spacing="6">
                                <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_source}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AudioSourceTrackOptions}"
                                              SelectedItem="{Binding SelectedAudioSourceTrack, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VideoAudioSourceOption">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_type}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WaveformStyleOptions}"
                                              SelectedItem="{Binding SelectedWaveformStyle, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_color_mode}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowVisualiser2DColorSettings}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding VisualiserColorModeOptions}"
                                              SelectedItem="{Binding SelectedVisualiserColorMode, Mode=TwoWay}"
                                              IsVisible="{Binding ShowVisualiser2DColorSettings}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_color}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowVisualiser2DColorSettings}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding WaveformColorPresets}"
                                              SelectedItem="{Binding SelectedWaveformColor, Mode=TwoWay}"
                                              IsVisible="{Binding ShowVisualiser2DColorSettings}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WaveformColorPreset">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_color_secondary}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowVisualiserGradientColor}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding WaveformColorPresets}"
                                              SelectedItem="{Binding SelectedVisualiserSecondaryColor, Mode=TwoWay}"
                                              IsVisible="{Binding ShowVisualiserGradientColor}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WaveformColorPreset">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_line_thickness}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowVisualiserLineThickness}"/>
                                    <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding SpectrumLineThickness, Mode=TwoWay}"
                                                     Minimum="0.5" Maximum="12" Increment="0.5" FormatString="F1"
                                                     IsVisible="{Binding ShowVisualiserSpectrumLineThickness}"/>
                                    <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Scope3DLineThickness, Mode=TwoWay}"
                                                     Minimum="0.005" Maximum="0.08" Increment="0.002" FormatString="F3"
                                                     IsVisible="{Binding ShowScope3DInspector}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_spectrum_min}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowVisualiserSpectrumSettings}"/>
                                    <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding SpectrumMinHz, Mode=TwoWay}"
                                                     Minimum="20" Maximum="20000" Increment="10" FormatString="F0"
                                                     IsVisible="{Binding ShowVisualiserSpectrumSettings}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_spectrum_max}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowVisualiserSpectrumSettings}"/>
                                    <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding SpectrumMaxHz, Mode=TwoWay}"
                                                     Minimum="40" Maximum="22000" Increment="100" FormatString="F0"
                                                     IsVisible="{Binding ShowVisualiserSpectrumSettings}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_bounds}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                        <NumericUpDown Value="{Binding WaveformX, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="X"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding WaveformY, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="Y"/>
                                        <NumericUpDown Grid.Column="2" Value="{Binding WaveformWidth, Mode=TwoWay}" Minimum="0.05" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="W"/>
                                        <NumericUpDown Grid.Column="3" Value="{Binding WaveformHeight, Mode=TwoWay}" Minimum="0.03" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="H"/>
                                    </Grid>
                                    <CheckBox Grid.Row="9" Grid.Column="1" Content="{DynamicResource VideoTrack_Waveform_follow_playhead}"
                                              IsChecked="{Binding WaveformFollowPlayhead, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource VideoTrack_Scope3d_camera_yaw}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowScope3DInspector}"/>
                                    <NumericUpDown Grid.Row="10" Grid.Column="1" Value="{Binding Scope3DCameraYaw, Mode=TwoWay}"
                                                     Minimum="-3.14" Maximum="3.14" Increment="0.05" FormatString="F2"
                                                     IsVisible="{Binding ShowScope3DInspector}"/>
                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="{DynamicResource VideoTrack_Scope3d_camera_pitch}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowScope3DInspector}"/>
                                    <NumericUpDown Grid.Row="11" Grid.Column="1" Value="{Binding Scope3DCameraPitch, Mode=TwoWay}"
                                                     Minimum="-1.2" Maximum="1.2" Increment="0.05" FormatString="F2"
                                                     IsVisible="{Binding ShowScope3DInspector}"/>
                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="{DynamicResource VideoTrack_Scope3d_camera_distance}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowScope3DInspector}"/>
                                    <NumericUpDown Grid.Row="12" Grid.Column="1" Value="{Binding Scope3DCameraDistance, Mode=TwoWay}"
                                                     Minimum="1.5" Maximum="12" Increment="0.1" FormatString="F1"
                                                     IsVisible="{Binding ShowScope3DInspector}"/>
                                    <TextBlock Grid.Row="13" Grid.Column="0" Text="{DynamicResource VideoTrack_Scope3d_trail_count}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowScope3DInspector}"/>
                                    <NumericUpDown Grid.Row="13" Grid.Column="1" Value="{Binding Scope3DTrailCount, Mode=TwoWay}"
                                                     Minimum="4" Maximum="40" Increment="1" FormatString="0"
                                                     IsVisible="{Binding ShowScope3DInspector}"/>
                                    <CheckBox Grid.Row="14" Grid.Column="1" Content="{DynamicResource VideoTrack_Scope3d_transparent}"
                                              IsChecked="{Binding Scope3DTransparentBackground, Mode=TwoWay}"
                                              IsVisible="{Binding ShowScope3DInspector}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3"
                                        IsVisible="{Binding ShowLayerEngine3DInspector}" Spacing="6">
                                <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoTrack_Engine3d_effect}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Engine3DEffectKindOptions}"
                                              SelectedItem="{Binding SelectedEngine3DEffectKind, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_source}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowEngine3DParticlesInspector}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AudioSourceTrackOptions}"
                                              SelectedItem="{Binding SelectedEngine3DAudioSourceTrack, Mode=TwoWay}"
                                              IsVisible="{Binding ShowEngine3DParticlesInspector}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VideoAudioSourceOption">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource VideoTrack_Engine3d_texture}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowEngine3DTexturedCubeInspector}"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding ShowEngine3DTexturedCubeInspector}">
                                        <TextBox Text="{Binding Engine3DImagePath, Mode=TwoWay}" MinWidth="120"/>
                                        <Button Content="{DynamicResource VideoTrack_Browse}" Command="{Binding BrowseEngine3DImageCommand}" Padding="6,3"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource VideoTrack_Engine3d_particle_count}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowEngine3DParticlesInspector}"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Engine3DParticleCount, Mode=TwoWay}"
                                                     Minimum="16" Maximum="384" Increment="16" FormatString="0"
                                                     IsVisible="{Binding ShowEngine3DParticlesInspector}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoTrack_Engine3d_particle_size}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowEngine3DParticlesInspector}"/>
                                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Engine3DParticleSize, Mode=TwoWay}"
                                                     Minimum="0.01" Maximum="0.35" Increment="0.01" FormatString="F2"
                                                     IsVisible="{Binding ShowEngine3DParticlesInspector}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource VideoTrack_Engine3d_particle_color}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowEngine3DParticlesInspector}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding WaveformColorPresets}"
                                              SelectedItem="{Binding SelectedEngine3DParticleColor, Mode=TwoWay}"
                                              IsVisible="{Binding ShowEngine3DParticlesInspector}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WaveformColorPreset">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource VideoTrack_Engine3d_particle_shape}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                               IsVisible="{Binding ShowEngine3DParticlesInspector}"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Engine3DParticleShapeOptions}"
                                              SelectedItem="{Binding SelectedEngine3DParticleShape, Mode=TwoWay}"
                                              IsVisible="{Binding ShowEngine3DParticlesInspector}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource VideoTrack_Scope3d_camera_yaw}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding Engine3DCameraYaw, Mode=TwoWay}"
                                                     Minimum="-3.14" Maximum="3.14" Increment="0.05" FormatString="F2"/>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource VideoTrack_Scope3d_camera_pitch}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding Engine3DCameraPitch, Mode=TwoWay}"
                                                     Minimum="-1.2" Maximum="1.2" Increment="0.05" FormatString="F2"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource VideoTrack_Scope3d_camera_distance}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding Engine3DCameraDistance, Mode=TwoWay}"
                                                     Minimum="1.5" Maximum="12" Increment="0.1" FormatString="F1"/>
                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource VideoTrack_Visualiser_bounds}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <Grid Grid.Row="10" Grid.Column="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                        <NumericUpDown Value="{Binding Engine3DX, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="X"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding Engine3DY, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="Y"/>
                                        <NumericUpDown Grid.Column="2" Value="{Binding Engine3DWidth, Mode=TwoWay}" Minimum="0.05" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="W"/>
                                        <NumericUpDown Grid.Column="3" Value="{Binding Engine3DHeight, Mode=TwoWay}" Minimum="0.03" Maximum="1" Increment="0.01" FormatString="F2"
                                                       ToolTip.Tip="H"/>
                                    </Grid>
                                    <CheckBox Grid.Row="11" Grid.Column="1" Content="{DynamicResource VideoTrack_Scope3d_transparent}"
                                              IsChecked="{Binding Engine3DTransparentBackground, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6"
                              IsVisible="{Binding ShowLayerSyncInspector}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoTrack_Offset_s}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding LayerOffsetSeconds, Mode=TwoWay}"
                                           Minimum="-3600" Maximum="3600" Increment="0.1" FormatString="F2"
                                           HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VideoTrack_In_s}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding LayerInPointSeconds, Mode=TwoWay}"
                                           Minimum="0" Maximum="86400" Increment="0.1" FormatString="F2"
                                           HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource VideoTrack_Out_s}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding LayerOutPointSeconds, Mode=TwoWay}"
                                           Minimum="0" Maximum="86400" Increment="0.1" FormatString="F2"
                                           HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource VideoTrack_FPS}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding LayerFps, Mode=TwoWay}"
                                           Minimum="1" Maximum="120" Increment="1" FormatString="0"
                                           HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoTrack_Sync_to_clip}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ArrangementClips}"
                                      SelectedItem="{Binding SelectedSyncClip, Mode=TwoWay}"
                                      PlaceholderText="{DynamicResource VideoTrack_Sync_to_clip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="panels:ClipSyncOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Row="5" Grid.Column="1" Content="{DynamicResource VideoTrack_Sync}"
                                    Command="{Binding SyncToClipCommand}" Padding="8,4" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding SelectedVisibilityRegion, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{DynamicResource VideoTimeline_Inspector_visibility}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoTimeline_Region_start}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding RegionStartBeat, Mode=TwoWay}" Minimum="0"
                                           Increment="0.25" FormatString="F2" MinWidth="{StaticResource VideoInspectorFieldWidth}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VideoTimeline_Region_end}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RegionEndBeat, Mode=TwoWay}" Minimum="0.25"
                                           Increment="0.25" FormatString="F2" MinWidth="{StaticResource VideoInspectorFieldWidth}" HorizontalAlignment="Left"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{DynamicResource VideoTimeline_Remove_region}"
                                    Command="{Binding RemoveVisibilityRegionCommand}" HorizontalAlignment="Left" Padding="8,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource VideoTimeline_Region_fade_in}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding RegionFadeInBeats, Mode=TwoWay}" Minimum="0"
                                           Increment="0.25" FormatString="F2" MinWidth="{StaticResource VideoInspectorFieldWidth}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoTimeline_Region_fade_out}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding RegionFadeOutBeats, Mode=TwoWay}" Minimum="0"
                                           Increment="0.25" FormatString="F2" MinWidth="{StaticResource VideoInspectorFieldWidth}" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding SelectedTrigger, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{DynamicResource VideoTimeline_Inspector_trigger}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoTrack_Trigger_source}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TriggerSourceOptions}"
                                      SelectedItem="{Binding SelectedTriggerSource, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VideoTrack_Trigger_clip}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                       IsVisible="{Binding ShowTriggerClipInspector}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ArrangementClips}"
                                      SelectedItem="{Binding SelectedTriggerClip, Mode=TwoWay}"
                                      PlaceholderText="{DynamicResource VideoTrack_Trigger_clip}"
                                      IsVisible="{Binding ShowTriggerClipInspector}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="panels:ClipSyncOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource VideoTrack_Trigger_midi_cc}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"
                                       IsVisible="{Binding ShowTriggerMidiCcInspector}"/>
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="6"
                                  IsVisible="{Binding ShowTriggerMidiCcInspector}">
                                <NumericUpDown Value="{Binding TriggerMidiCcChannel, Mode=TwoWay}" Minimum="0" Maximum="15"
                                               FormatString="0" ToolTip.Tip="Channel"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding TriggerMidiCcNumber, Mode=TwoWay}" Minimum="0" Maximum="127"
                                               FormatString="0" ToolTip.Tip="CC"/>
                                <NumericUpDown Grid.Column="2" Value="{Binding TriggerMidiCcThreshold, Mode=TwoWay}" Minimum="0" Maximum="127"
                                               FormatString="0" ToolTip.Tip="Threshold"/>
                            </Grid>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource VideoTrack_Trigger_moment}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding TriggerMomentOptions}"
                                      SelectedItem="{Binding SelectedTriggerMoment, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoTrack_Trigger_action}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding TriggerActionOptions}"
                                      SelectedItem="{Binding SelectedTriggerAction, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource VideoTrack_Trigger_target}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding TargetLayerOptions}"
                                      SelectedItem="{Binding SelectedTriggerTarget, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="media:VideoLayer">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource VideoTrack_Fade_duration_s}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding SelectedTrigger.FadeDurationSeconds, Mode=TwoWay}"
                                           Minimum="0" Maximum="30" Increment="0.1" FormatString="F2"
                                           MinWidth="{StaticResource VideoInspectorFieldWidth}" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
