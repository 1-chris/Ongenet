<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ongenet.App.ViewModels.Panels"
             x:Class="Ongenet.App.Views.Panels.VideoTrackView"
             x:DataType="vm:VideoTrackViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Background="{StaticResource CatppuccinBase}">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8" Spacing="8">
            <TextBlock Text="{DynamicResource VideoTrack_Video}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource CatppuccinText}" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource VideoTrack_Add_Track}" Command="{Binding AddTrackCommand}" Padding="10,4" FontSize="11"/>
            <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource CatppuccinOverlay1}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="12,0,12,8" Padding="10"
                Background="{StaticResource CatppuccinMantle}" CornerRadius="4"
                IsVisible="{Binding HasSelection}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Tracks}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          MinWidth="120" PlaceholderText="{DynamicResource VideoTrack_Video_track}"/>
                <TextBox Grid.Column="1" Text="{Binding FilePath}" PlaceholderText="{DynamicResource VideoTrack_Video_file_path}"/>
                <Button Grid.Column="2" Content="{DynamicResource VideoTrack_Browse}" Command="{Binding BrowseCommand}" Padding="8,4"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource VideoTrack_Offset_s}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                    <NumericUpDown Value="{Binding OffsetSeconds, Mode=TwoWay}" Minimum="-3600" Maximum="3600"
                                   Increment="0.1" FormatString="F2" Width="90"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource VideoTrack_FPS}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                    <NumericUpDown Value="{Binding Fps, Mode=TwoWay}" Minimum="1" Maximum="120"
                                   Increment="1" FormatString="0" Width="70"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource VideoTrack_In_s}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                    <NumericUpDown Value="{Binding InPointSeconds, Mode=TwoWay}" Minimum="0" Maximum="86400"
                                   Increment="0.1" FormatString="F2" Width="80"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{DynamicResource VideoTrack_Out_s}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                    <NumericUpDown Value="{Binding OutPointSeconds, Mode=TwoWay}" Minimum="0" Maximum="86400"
                                   Increment="0.1" FormatString="F2" Width="80"
                                   ToolTip.Tip="{DynamicResource VideoTrack_N0_use_full_video_duration_Tip}"/>
                </StackPanel>
                <CheckBox Grid.Column="7" Content="{DynamicResource VideoTrack_Muted}" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="12" Background="{StaticResource CatppuccinCrust}" CornerRadius="4">
            <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            IsVisible="{Binding !IsFfmpegAvailable}" Margin="16">
                    <TextBlock Text="{DynamicResource VideoTrack_Video_sync_no_preview}" FontWeight="SemiBold"
                               Foreground="{StaticResource CatppuccinText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="360"
                               Foreground="{StaticResource CatppuccinOverlay1}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SyncTimeSeconds, StringFormat='Sync time: {0:F2}s'}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource CatppuccinLavender}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource VideoTrack_Install_ffmpeg_to_see_frame_preview}"
                               FontSize="11" Foreground="{StaticResource CatppuccinOverlay0}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <Image Source="{Binding Frame}" Stretch="Uniform" Margin="8"
                       IsVisible="{Binding IsFfmpegAvailable}"/>
            </Panel>
        </Border>
    </Grid>
</UserControl>
