<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ongenet.App.ViewModels.Panels"
             xmlns:media="using:Ongenet.Core.Models.Media"
             xmlns:controls="using:Ongenet.App.Controls"
             xmlns:display="using:Ongenet.App.Display"
             x:Class="Ongenet.App.Views.Panels.VideoTrackView"
             x:DataType="vm:VideoTrackViewModel">
    <UserControl.Resources>
        <x:Double x:Key="VideoInspectorLabelWidth">72</x:Double>
        <x:Double x:Key="VideoInspectorFieldWidth">116</x:Double>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" Background="{StaticResource CatppuccinBase}">
        <StackPanel Grid.Row="0" IsVisible="{Binding !IsProjectVideoEnabled}" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="12" Margin="24">
            <TextBlock Text="{DynamicResource VideoTrack_Enable_project_video}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource CatppuccinText}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource VideoTrack_Enable_project_video_body}" FontSize="11"
                       Foreground="{StaticResource CatppuccinOverlay1}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420"/>
            <Button Content="{DynamicResource VideoTrack_Enable_video}" Command="{Binding EnableProjectVideoCommand}"
                    HorizontalAlignment="Center" Padding="16,8"/>
        </StackPanel>

        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,*"
              IsVisible="{Binding IsProjectVideoEnabled}">
            <StackPanel Grid.Row="0" Margin="12,8" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource VideoTrack_Program_monitor}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource CatppuccinText}" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource VideoResources_Add_layer}" Command="{Binding AddLayerCommand}" Padding="10,4" FontSize="11"/>
                    <CheckBox Content="{DynamicResource VideoTrack_Muted}" IsChecked="{Binding IsMuted, Mode=TwoWay}" VerticalAlignment="Center"
                              IsVisible="{Binding HasSyncVideo}"/>
                    <CheckBox Content="{DynamicResource VideoTrack_Live_preview}" IsChecked="{Binding UseLivePreview, Mode=TwoWay}"
                              IsEnabled="{Binding IsLivePreviewAvailable}" VerticalAlignment="Center"
                              IsVisible="{Binding HasSyncVideo}"/>
                    <Button Content="{DynamicResource VideoTrack_Pop_out}" Command="{Binding PopOutCommand}" Padding="10,4" FontSize="11"/>
                    <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource CatppuccinOverlay1}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource VideoTrack_Canvas_preset}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                    <ComboBox ItemsSource="{Binding ResolutionPresets}" SelectedItem="{Binding SelectedResolutionPreset, Mode=TwoWay}"
                              MinWidth="140">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VideoResolutionPreset">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomResolution}">
                        <TextBlock Text="{DynamicResource VideoTrack_Canvas_width}" Width="{StaticResource VideoInspectorLabelWidth}"
                                   FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <NumericUpDown Value="{Binding CustomCanvasWidth, Mode=TwoWay}" Minimum="320" Maximum="4096"
                                       Increment="1" FormatString="0" MinWidth="{StaticResource VideoInspectorFieldWidth}"/>
                        <TextBlock Text="{DynamicResource VideoTrack_Canvas_height}" Width="{StaticResource VideoInspectorLabelWidth}"
                                   FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                        <NumericUpDown Value="{Binding CustomCanvasHeight, Mode=TwoWay}" Minimum="320" Maximum="4096"
                                       Increment="1" FormatString="0" MinWidth="{StaticResource VideoInspectorFieldWidth}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Margin="12" Background="{StaticResource CatppuccinCrust}" CornerRadius="4">
                <Panel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                IsVisible="{Binding ShowGettingStarted}" Margin="24" MaxWidth="420">
                        <TextBlock Text="{DynamicResource VideoTrack_Getting_started_title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource CatppuccinText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource VideoTrack_Getting_started_step1}" FontSize="11"
                                   Foreground="{StaticResource CatppuccinOverlay1}"/>
                        <TextBlock Text="{DynamicResource VideoTrack_Getting_started_step2}" FontSize="11"
                                   Foreground="{StaticResource CatppuccinOverlay1}"/>
                        <TextBlock Text="{DynamicResource VideoTrack_Getting_started_step3}" FontSize="11"
                                   Foreground="{StaticResource CatppuccinOverlay1}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="{DynamicResource VideoResources_Add_layer}" Command="{Binding AddLayerCommand}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="4" Margin="16"
                                IsVisible="{Binding !IsFfmpegAvailable}">
                        <TextBlock Text="{DynamicResource VideoTrack_Video_sync_no_preview}" FontWeight="SemiBold"
                                   Foreground="{StaticResource CatppuccinText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="360"
                                   Foreground="{StaticResource CatppuccinOverlay1}" HorizontalAlignment="Center"
                                   IsVisible="{Binding HasSyncVideo}"/>
                        <TextBlock Text="{DynamicResource VideoTrack_Install_ffmpeg_to_see_frame_preview}"
                                   FontSize="11" Foreground="{StaticResource CatppuccinOverlay0}"
                                   HorizontalAlignment="Center" IsVisible="{Binding HasSyncVideo}"/>
                    </StackPanel>

                    <controls:VideoCompositionCanvas DataContext="{Binding}"/>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,3"
                            Background="#AA1E1E2E" CornerRadius="3" IsHitTestVisible="False">
                        <TextBlock Text="{Binding CanvasSizeLabel}" FontSize="10"
                                   Foreground="{StaticResource CatppuccinSubtext0}"/>
                    </Border>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
