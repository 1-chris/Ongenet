<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ongenet.App.ViewModels"
             xmlns:pr="using:Ongenet.App.ViewModels.PianoRoll"
             xmlns:controls="using:Ongenet.App.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="240"
             x:Class="Ongenet.App.Views.Panels.PianoRollView"
             x:DataType="vm:PianoRollViewModel">

    <UserControl.Resources>
        <x:Double x:Key="KeyGutterWidth">56</x:Double>
        <x:Double x:Key="PrRulerHeight">22</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.PrTool">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
            <Setter Property="Foreground" Value="{StaticResource CatppuccinText}"/>
        </Style>
        <Style Selector="Button.PrTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface1}"/>
        </Style>
        <Style Selector="ToggleButton.PrToolToggle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
            <Setter Property="Foreground" Value="{StaticResource CatppuccinText}"/>
        </Style>
        <Style Selector="ToggleButton.PrToolToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CatppuccinMauve}"/>
            <Setter Property="Foreground" Value="{StaticResource CatppuccinCrust}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource CatppuccinCrust}"
            BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*">

            <!-- control bar (spans the full width, above the ruler) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{StaticResource CatppuccinMantle}"
                    BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,0,0,1"
                    Padding="4,3">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="PrTool" Content="{DynamicResource PianoRoll_Import_MIDI}" Click="Import_Click"
                            ToolTip.Tip="{DynamicResource PianoRoll_Import_a_mid_file_into_this_clip_Tip}"/>
                    <Button Classes="PrTool" Content="{DynamicResource PianoRoll_Export_MIDI}" Click="Export_Click"
                            ToolTip.Tip="{DynamicResource PianoRoll_Export_this_clips_notes_to_a_mid_file_Tip}"/>
                    <Button Classes="PrTool" Content="{DynamicResource PianoRoll_Generator}" Click="Generator_Click"
                            ToolTip.Tip="{DynamicResource PianoRoll_Generate_randomized_chords_chord_progressions_Tip}"/>
                    <Border Width="1" Margin="3,1" Background="{StaticResource CatppuccinSurface0}"/>
                    <ToggleButton Classes="PrToolToggle" Content="{DynamicResource PianoRoll_Edit}" IsChecked="{Binding IsEditMode}"
                                  ToolTip.Tip="{DynamicResource PianoRoll_Edit_tool_draw_move_resize_With_several_selected_Tip}"/>
                    <ToggleButton Classes="PrToolToggle" Content="{DynamicResource PianoRoll_Select}" IsChecked="{Binding IsSelectMode}"
                                  ToolTip.Tip="{DynamicResource PianoRoll_Multi_select_tool_click_drag_a_rubber_band_over__Tip}"/>
                    <ToggleButton Classes="PrToolToggle" Content="{DynamicResource PianoRoll_Slice}" IsChecked="{Binding IsSliceMode}"
                                  ToolTip.Tip="{DynamicResource PianoRoll_Slice_tool_click_drag_a_line_to_cut_through_one__Tip}"/>
                    <Border Width="1" Margin="3,1" Background="{StaticResource CatppuccinSurface0}"/>
                    <Button Classes="PrTool" Content="{DynamicResource PianoRoll_Arpeggio}" Click="Arp_Click"
                            ToolTip.Tip="{DynamicResource PianoRoll_Convert_the_selected_notes_into_an_arpeggio_Tip}"/>
                    <Button Classes="PrTool" Content="{DynamicResource PianoRoll_Quantize}" Command="{Binding QuantizeClipCommand}"
                            ToolTip.Tip="{DynamicResource PianoRoll_Quantize_note_starts_and_lengths_to_the_current__Tip}"/>
                    <Button Classes="PrTool" Content="{DynamicResource PianoRoll_Groove}" Command="{Binding ApplyGrooveCommand}"
                            ToolTip.Tip="{DynamicResource PianoRoll_Apply_the_projects_active_groove_to_note_timing_Tip}"/>
                    <ToggleButton Classes="PrToolToggle" Content="{DynamicResource PianoRoll_MPE}" IsChecked="{Binding ShowExpressionLane}"
                                  ToolTip.Tip="{DynamicResource PianoRoll_Show_the_per_beat_CC74_pressure_expression_lane_Tip}"/>
                    <Border Width="1" Margin="3,1" Background="{StaticResource CatppuccinSurface0}"/>
                    <CheckBox Content="{DynamicResource PianoRoll_Scale_snap}" IsChecked="{Binding ScaleSnapEnabled}"
                              FontSize="11" VerticalAlignment="Center"
                              ToolTip.Tip="{DynamicResource PianoRoll_Snap_drawn_and_moved_notes_to_the_selected_key_s_Tip}"/>
                    <ComboBox ItemsSource="{Binding ScaleRootNotes}" SelectedIndex="{Binding ScaleRootIndex}"
                              Width="52" FontSize="11" VerticalAlignment="Center"
                              IsEnabled="{Binding ScaleSnapEnabled}"/>
                    <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}"
                              Width="120" FontSize="11" VerticalAlignment="Center"
                              IsEnabled="{Binding ScaleSnapEnabled}"/>
                </StackPanel>
            </Border>

            <!-- corner -->
            <Border Grid.Row="1" Grid.Column="0"
                    Width="{StaticResource KeyGutterWidth}" Height="{StaticResource PrRulerHeight}"
                    Background="{StaticResource CatppuccinMantle}"
                    BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,0,1,1">
                <TextBlock Text="{Binding ClipName}" Margin="6,0" VerticalAlignment="Center"
                           FontSize="10" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
            </Border>

            <!-- ruler (slaved horizontally) -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" Name="PrRulerScroll"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Background="{StaticResource CatppuccinMantle}">
                <controls:PianoRollRulerControl Width="{Binding Metrics.TotalWidth}" Height="{StaticResource PrRulerHeight}"
                                                PixelsPerBeat="{Binding Metrics.PixelsPerBeat}"
                                                TotalBeats="{Binding Metrics.TotalBeats}"
                                                BeatsPerBar="{Binding Metrics.BeatsPerBar}"/>
            </ScrollViewer>

            <!-- key gutter (slaved vertically) -->
            <ScrollViewer Grid.Row="2" Grid.Column="0" Name="PrKeysScroll"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                          Background="{StaticResource CatppuccinMantle}">
                <ItemsControl ItemsSource="{Binding Keys}"
                              Width="{StaticResource KeyGutterWidth}" Height="{Binding Metrics.TotalHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="pr:PianoKeyViewModel">
                            <Setter Property="Canvas.Left" Value="0"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pr:PianoKeyViewModel">
                            <Border Width="{StaticResource KeyGutterWidth}" Height="{Binding Height}"
                                    Background="{StaticResource CatppuccinSurface1}"
                                    BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,0,0,1"
                                    PointerPressed="OnKeyPressed" PointerReleased="OnKeyReleased"
                                    PointerExited="OnKeyExited">
                                <Panel>
                                    <Border IsVisible="{Binding IsBlack}" Background="{StaticResource CatppuccinCrust}"/>
                                    <Border IsVisible="{Binding IsActive}" Background="{StaticResource CatppuccinMauve}"/>
                                    <TextBlock Text="{Binding Name}" IsVisible="{Binding IsC}"
                                               FontSize="9" Margin="5,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- note grid (master scroll) -->
            <ScrollViewer Grid.Row="2" Grid.Column="1" Name="PrGridScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Panel Name="PianoGrid" Background="Transparent"
                       Width="{Binding Metrics.TotalWidth}" Height="{Binding Metrics.TotalHeight}">
                    <controls:PianoRollBackgroundControl IsHitTestVisible="False"
                                                         PixelsPerBeat="{Binding Metrics.PixelsPerBeat}"
                                                         TotalBeats="{Binding Metrics.TotalBeats}"
                                                         BeatsPerBar="{Binding Metrics.BeatsPerBar}"/>
                    <Border Name="Band" IsVisible="False" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource CatppuccinMauve}" Opacity="0.2"
                            BorderBrush="{StaticResource CatppuccinMauve}" BorderThickness="1"/>
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="pr:NoteViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                <Setter Property="Width" Value="{Binding Width}"/>
                                <Setter Property="Height" Value="{Binding Height}"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pr:NoteViewModel">
                                <Border CornerRadius="2" Background="{StaticResource CatppuccinMauve}"
                                        BorderBrush="{StaticResource CatppuccinText}"
                                        Classes.selected="{Binding IsSelected}">
                                    <Border.Styles>
                                        <Style Selector="Border"><Setter Property="BorderThickness" Value="0"/></Style>
                                        <Style Selector="Border.selected"><Setter Property="BorderThickness" Value="1"/></Style>
                                    </Border.Styles>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Line Name="SliceLine" IsVisible="False" IsHitTestVisible="False"
                          Stroke="{StaticResource CatppuccinRed}" StrokeThickness="1"
                          StartPoint="0,0" EndPoint="0,0"/>
                </Panel>
            </ScrollViewer>

            <Border Grid.Row="3" Grid.Column="0" IsVisible="{Binding ShowExpressionLane}"
                    Background="{StaticResource CatppuccinMantle}" BorderBrush="{StaticResource CatppuccinCrust}"
                    BorderThickness="0,1,1,0" Padding="4">
                <TextBlock Text="{DynamicResource PianoRoll_MPE_74}" FontSize="9" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
            </Border>
            <ScrollViewer Grid.Row="3" Grid.Column="1" IsVisible="{Binding ShowExpressionLane}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Height="52" Background="{StaticResource CatppuccinMantle}">
                <ItemsControl ItemsSource="{Binding ExpressionPoints}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpressionLanePoint">
                            <Border Width="30" Height="48" BorderBrush="{StaticResource CatppuccinSurface0}"
                                    BorderThickness="0,0,1,0">
                                <Grid RowDefinitions="*,Auto">
                                    <ProgressBar Grid.Row="0" Minimum="0" Maximum="1" Value="{Binding Value}"
                                                 Width="18" VerticalAlignment="Stretch"
                                                 Foreground="{StaticResource CatppuccinTeal}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Beat}" FontSize="8"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
