<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ongenet.App.ViewModels.Panels"
             x:Class="Ongenet.App.Views.Panels.ScriptingPanelView"
             x:DataType="vm:ScriptingPanelViewModel">
    <Grid RowDefinitions="Auto, *, Auto" Margin="8" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource Scripts_Load}" Click="LoadScript_Click" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripting_New}" Command="{Binding NewScriptCommand}" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripting_Save}" Command="{Binding SaveCommand}" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripting_ExportProject}" Command="{Binding ExportProjectCommand}" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripting_ExportPreset}" Command="{Binding ExportPresetCommand}" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripts_Save_as}" Click="SaveScriptAs_Click" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripts_Reload}" Command="{Binding ReloadCommand}" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripts_Unload}" Command="{Binding UnloadCommand}" FontSize="11" Padding="10,4"/>
            <Separator Width="1" Height="18" Background="{StaticResource CatppuccinSurface1}"/>
            <Button Content="{DynamicResource Scripts_Run}" Command="{Binding RunCommand}" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripts_Start_live}" Command="{Binding StartLiveCommand}" FontSize="11" Padding="10,4"/>
            <Button Content="{DynamicResource Scripts_Stop_live}" Command="{Binding StopLiveCommand}" FontSize="11" Padding="10,4"/>
            <Separator Width="1" Height="18" Background="{StaticResource CatppuccinSurface1}"/>
            <Button Content="{DynamicResource Scripting_Pop_out}" Command="{Binding PopOutCommand}" FontSize="11" Padding="10,4"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="220, *, 220" ColumnSpacing="8">
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="{DynamicResource Scripts_Loaded_scripts}" FontSize="11"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Scripts}"
                         SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                         Background="{StaticResource CatppuccinMantle}"
                         BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="1" CornerRadius="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScriptItemViewModel">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource CatppuccinText}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource CatppuccinSubtext0}"/>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource CatppuccinMantle}"
                    BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="1" CornerRadius="4">
                <ContentPresenter x:Name="EditorHost"/>
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="{DynamicResource Scripts_Output}" FontSize="11"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
                <ScrollViewer Grid.Row="1" Background="{StaticResource CatppuccinMantle}"
                              BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="1" CornerRadius="4">
                    <TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas, Menlo, monospace" FontSize="11"
                             Background="Transparent" BorderThickness="0" Padding="8"/>
                </ScrollViewer>
                <Button Grid.Row="2" Content="{DynamicResource Scripts_Clear_output}" HorizontalAlignment="Right"
                        Command="{Binding ClearOutputCommand}" FontSize="10" Padding="8,2"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" FontSize="10" Foreground="{StaticResource CatppuccinOverlay1}">
            <Run Text="{Binding ErrorCount, StringFormat='Errors: {0}  '}"/>
            <Run Text="{Binding WarningCount, StringFormat='Warnings: {0}'}"/>
        </TextBlock>
    </Grid>
</UserControl>
