<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="https://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ongenet.App.ViewModels"
             xmlns:controls="using:Ongenet.App.Controls"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="600"
             x:Class="Ongenet.App.Views.Panels.ProjectClipsView"
             x:DataType="vm:ProjectClipsViewModel">

    <Border Background="{StaticResource CatppuccinMantle}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="6,6,6,2">
                <controls:IconButton DockPanel.Dock="Right" Classes="flat"
                                     Width="28" Height="28" IconSize="16"
                                     Icon="{StaticResource IconPlus}"
                                     Command="{Binding NewCategoryCommand}"
                                     ToolTip.Tip="{DynamicResource ProjectClips_NewCategory_Tip}"/>
                <ComboBox ItemsSource="{Binding SortModes}"
                          SelectedItem="{Binding SelectedSortMode}"
                          HorizontalAlignment="Stretch"
                          FontSize="11"
                          MinHeight="28"
                          ToolTip.Tip="{DynamicResource ProjectClips_Sort_Tip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectClipsSortModeOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <Panel>
                <TextBlock Text="{DynamicResource ProjectClips_The_projects_MIDI_and_audio_clips_appear_here_Dr}"
                           IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                           Margin="12" FontSize="11" Foreground="{StaticResource CatppuccinOverlay1}"/>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Name="GroupsList" ItemsSource="{Binding Groups}" Margin="6,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectClipGroupViewModel">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                               Margin="2,8,0,2"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProjectClipItemViewModel">
                                                <controls:ProjectClipCardControl DataContext="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
