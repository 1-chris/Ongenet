<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fx="using:Ongenet.App.ViewModels.Effects"
             xmlns:controls="using:Ongenet.App.Controls"
             xmlns:panels="using:Ongenet.App.Views.Panels"
             xmlns:field="using:Ongenet.App.Views.Field"
             xmlns:fieldControls="using:Ongenet.App.Controls.Field"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="200"
             x:Class="Ongenet.App.Views.Panels.EffectChainView"
             x:DataType="fx:EffectChainViewModel">

    <UserControl.Styles>
        <Style Selector="Button.masteringActive.active">
            <Setter Property="Background" Value="{StaticResource CatppuccinMauve}"/>
        </Style>
        <Style Selector="Border.signalStage">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CatppuccinMantle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinSurface1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style Selector="Border.signalStage:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Border.signalStage.highlighted">
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinMauve}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <WrapPanel Orientation="Horizontal">
            <Button Content="{DynamicResource EffectChain_Add_effect}" Margin="0,0,8,0" Background="{StaticResource CatppuccinSurface0}">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="200" Spacing="6">
                          <TextBox Text="{Binding EffectSearchFilter, Mode=TwoWay}"
                                   PlaceholderText="Search effects…"/>
                          <ScrollViewer MaxHeight="420">
                            <ItemsControl ItemsSource="{Binding AddableCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="fx:EffectCategoryViewModel">
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                                       Margin="2,4,2,2"
                                                       Foreground="{StaticResource CatppuccinOverlay1}"/>
                                            <ItemsControl ItemsSource="{Binding Effects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="fx:AvailableEffectViewModel">
                                                        <Button Content="{Binding Name}" Command="{Binding AddCommand}"
                                                                HorizontalAlignment="Stretch" Margin="0,1"
                                                                HorizontalContentAlignment="Left"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Name="SaveChainButton" Content="{DynamicResource EffectChain_Save_chain}" IsVisible="{Binding HasEffects}" Margin="0,0,8,0"
                    Background="{StaticResource CatppuccinSurface0}"
                    ToolTip.Tip="{DynamicResource EffectChain_Save_this_whole_effect_chain_as_a_preset_Tip}">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="200" Spacing="6">
                            <TextBlock Text="{DynamicResource EffectChain_FX_chain_name}" FontSize="11"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <TextBox Text="{Binding ChainPresetName, Mode=TwoWay}" PlaceholderText="{DynamicResource EffectChain_FX_Chain}"/>
                            <Button Content="{DynamicResource EffectChain_Save}" Click="OnSaveChain" HorizontalAlignment="Right"
                                    Background="{StaticResource CatppuccinSurface1}"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <TextBlock Text="{DynamicResource EffectChain_signal_chain_top_first_bottom_last}" VerticalAlignment="Center"
                       FontSize="11" FontStyle="Italic" IsVisible="{Binding HasEffects}"
                       Foreground="{StaticResource CatppuccinOverlay1}"/>
          </WrapPanel>

          <!-- Mastering tools (Master track only): collapsible sections + always-visible toolbar. -->
          <StackPanel IsVisible="{Binding ShowMasteringTools}" Spacing="6">

            <Expander Header="Chain" IsExpanded="{Binding SectionChainExpanded, Mode=TwoWay}">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <WrapPanel>
                  <TextBlock Text="{DynamicResource Mastering_ChainPicker}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox Width="220" Margin="0,0,8,0" ItemsSource="{Binding MasteringChainOptions}"
                            SelectedItem="{Binding SelectedMasteringChain, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="fx:MasteringChainOption">
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}"/>
                          <TextBlock Text="{Binding DisplayDescription}" FontSize="10" TextWrapping="Wrap"
                                     Foreground="{StaticResource CatppuccinOverlay1}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox Content="{DynamicResource Mastering_AppendChain}"
                            IsChecked="{Binding AppendMasteringChain, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Content="{DynamicResource Mastering_ApplyChain}" Command="{Binding ApplySelectedMasteringChainCommand}"
                          Background="{StaticResource CatppuccinSurface0}"/>
                </WrapPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SignalFlowStages}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="fx:SignalFlowStageItem">
                        <Border Classes="signalStage" IsEnabled="{Binding Enabled}"
                                Classes.highlighted="{Binding Highlighted}">
                          <StackPanel Spacing="2" MinWidth="36">
                            <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding GrNormalized}" Height="4"
                                         Foreground="{StaticResource CatppuccinMauve}"
                                         Background="{StaticResource CatppuccinSurface1}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Expander>

            <Expander Header="Metering" IsExpanded="{Binding SectionMeteringExpanded, Mode=TwoWay}">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding MasteringMeterText}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CatppuccinGreen}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PeakHoldText}" FontSize="10"
                           Foreground="{StaticResource CatppuccinSubtext0}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ComplianceSummaryText}" FontSize="10"
                           Foreground="{StaticResource CatppuccinPeach}" TextWrapping="Wrap"/>
                <Canvas Height="40" Width="200" ClipToBounds="True" HorizontalAlignment="Left"
                        Background="{StaticResource CatppuccinMantle}">
                  <Line StartPoint="0,0" EndPoint="200,0" Canvas.Top="{Binding LufsTargetLineY}"
                        Stroke="{StaticResource CatppuccinPeach}" StrokeThickness="1"/>
                  <Polyline Points="{Binding LufsHistoryPoints}" Stroke="{StaticResource CatppuccinGreen}"
                            StrokeThickness="1.5"/>
                </Canvas>
                <WrapPanel>
                  <TextBlock Text="History" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"
                             Foreground="{StaticResource CatppuccinSubtext0}"/>
                  <ComboBox Width="80" Margin="0,0,8,0" ItemsSource="{Binding LufsHistoryWindows}"
                            SelectedItem="{Binding LufsHistoryWindow, Mode=TwoWay}"/>
                  <Button Content="{DynamicResource Mastering_ResetLoudness}" Command="{Binding ResetLoudnessCommand}"
                          Margin="0,0,8,0" Background="{StaticResource CatppuccinSurface0}"/>
                  <Button Content="Preflight analyse" Command="{Binding PreflightAnalyseCommand}"
                          Background="{StaticResource CatppuccinSurface0}"/>
                </WrapPanel>
                <TextBlock Text="{Binding PreflightReportText}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
                <WrapPanel>
                  <Button Content="Suggest LUFS" Command="{Binding SuggestLufsAssistCommand}"
                          Margin="0,0,8,0" Background="{StaticResource CatppuccinSurface0}"/>
                  <TextBlock Text="{Binding LufsAssistSuggestionText}" FontSize="10" TextWrapping="Wrap"
                             VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                </WrapPanel>
                <WrapPanel>
                  <TextBlock Text="{DynamicResource Mastering_MeterTap}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox Width="120" ItemsSource="{Binding MeterTapChoices}"
                            SelectedItem="{Binding SelectedMeterTapChoice, Mode=TwoWay}"
                            ToolTip.Tip="{DynamicResource Mastering_MeterTap_Tip}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="fx:MeterTapChoice">
                        <TextBlock Text="{Binding Label}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </WrapPanel>
              </StackPanel>
            </Expander>

            <Expander Header="Delivery" IsExpanded="{Binding SectionDeliveryExpanded, Mode=TwoWay}">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <WrapPanel>
                  <TextBlock Text="{DynamicResource Mastering_DeliveryTarget}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox Width="160" ItemsSource="{Binding DeliveryPlatforms}"
                            SelectedItem="{Binding SelectedDeliveryPlatform, Mode=TwoWay}"
                            ToolTip.Tip="{DynamicResource Mastering_DeliveryPlatform_Tip}"/>
                </WrapPanel>
                <TextBlock Text="{Binding DeliveryTargetText}" FontSize="11"
                           Foreground="{StaticResource CatppuccinPeach}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCustomDeliveryPlatform}">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Target LUFS" FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"/>
                    <NumericUpDown Value="{Binding CustomTargetLufs, Mode=TwoWay}"
                                   Minimum="-30" Maximum="-5" Increment="0.5" FormatString="0.0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Target dBTP" FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"/>
                    <NumericUpDown Value="{Binding CustomTargetDbTp, Mode=TwoWay}"
                                   Minimum="-6" Maximum="0" Increment="0.1" FormatString="0.0"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding NormalizePreviewText}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
                <WrapPanel>
                  <CheckBox Content="Auto-sync limiter ceiling"
                            IsChecked="{Binding AutoSyncLimiterCeiling, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Content="Sync ceiling" Command="{Binding SyncLimiterCeilingCommand}"
                          Background="{StaticResource CatppuccinSurface0}"/>
                </WrapPanel>
                <TextBlock Text="{Binding LimiterCeilingMismatchText}" FontSize="10" TextWrapping="Wrap"
                           IsVisible="{Binding LimiterCeilingMismatch}"
                           Foreground="{StaticResource CatppuccinRed}"/>
              </StackPanel>
            </Expander>

            <WrapPanel>
              <Button Content="{DynamicResource EffectChain_Bypass_chain}" Command="{Binding BypassAllCommand}"
                      Margin="0,0,6,0" Classes="masteringActive"
                      Classes.active="{Binding ChainBypassed}" Background="{StaticResource CatppuccinSurface0}"
                      ToolTip.Tip="{DynamicResource EffectChain_Bypass_chain_Tip}"/>
              <Button Content="{DynamicResource EffectChain_Restore_chain}" Command="{Binding RestoreBypassCommand}"
                      Margin="0,0,6,0" Background="{StaticResource CatppuccinSurface0}"/>
              <Button Content="{DynamicResource EffectChain_Compare}" Command="{Binding ToggleCompareBypassCommand}"
                      Margin="0,0,6,0" Classes="masteringActive"
                      Classes.active="{Binding CompareBypassActive}" Background="{StaticResource CatppuccinSurface0}"
                      ToolTip.Tip="{DynamicResource EffectChain_Compare_Tip}"/>
              <CheckBox Content="Full chain bypass" IsChecked="{Binding CompareFullChainBypass, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding CompareMakeupText}" VerticalAlignment="Center" Margin="0,0,8,0"
                         FontSize="10" Foreground="{StaticResource CatppuccinMauve}"/>
              <Button Content="{Binding AbSlotALabel}" Command="{Binding StoreAbACommand}" Margin="0,0,6,0"
                      Background="{StaticResource CatppuccinSurface0}"
                      ToolTip.Tip="{Binding AbSlotADetail}"/>
              <Button Content="{Binding AbSlotBLabel}" Command="{Binding StoreAbBCommand}" Margin="0,0,6,0"
                      Background="{StaticResource CatppuccinSurface0}"
                      ToolTip.Tip="{Binding AbSlotBDetail}"/>
              <Button Content="{Binding AbLabel}" Command="{Binding ToggleAbCommand}" Margin="0,0,6,0"
                      Background="{StaticResource CatppuccinSurface1}"
                      ToolTip.Tip="{DynamicResource Mastering_AB_Toggle_Tip}"/>
              <CheckBox Content="Match loudness" IsChecked="{Binding AbLoudnessMatch, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Button Content="{DynamicResource Mastering_MonoAudition}" Command="{Binding ToggleMonoCommand}"
                      Classes="masteringActive" Classes.active="{Binding MonoAuditionActive}"
                      Background="{StaticResource CatppuccinSurface0}"/>
              <TextBlock Text="{Binding CompareInsertsToolHint}" FontSize="10" TextWrapping="Wrap"
                         IsVisible="{Binding CompareBypassActive}" Margin="0,4,0,0"
                         Foreground="{StaticResource CatppuccinMauve}"/>
            </WrapPanel>

            <Expander Header="Reference" IsExpanded="{Binding SectionReferenceExpanded, Mode=TwoWay}">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <WrapPanel>
                  <Button Content="{DynamicResource Mastering_Reference_Browse}" Click="OnBrowseReference"
                          Margin="0,0,6,0" Background="{StaticResource CatppuccinSurface1}"/>
                  <Button Content="{DynamicResource Mastering_Reference_CaptureMatchEq}"
                          Command="{Binding CaptureReferenceToMatchEqCommand}"
                          IsVisible="{Binding HasReference}" Margin="0,0,6,0"
                          Background="{StaticResource CatppuccinSurface1}"
                          ToolTip.Tip="{DynamicResource Mastering_Reference_CaptureMatchEq_Tip}"/>
                  <Button Content="{DynamicResource Mastering_Reference_Hold}" IsVisible="{Binding HasReference}"
                          PointerPressed="OnReferencePressed" PointerReleased="OnReferenceReleased"
                          Margin="0,0,6,0" Background="{StaticResource CatppuccinMauve}"/>
                  <Button Content="Latch" Command="{Binding ToggleReferenceLatchCommand}"
                          IsVisible="{Binding HasReference}" Margin="0,0,6,0" Classes="masteringActive"
                          Classes.active="{Binding ReferenceLatched}"
                          Background="{StaticResource CatppuccinSurface0}"/>
                  <CheckBox Content="{DynamicResource Mastering_Reference_Synced}"
                            IsChecked="{Binding ReferenceAuditionSynced, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="Gain dB" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10"
                             Foreground="{StaticResource CatppuccinSubtext0}"/>
                  <NumericUpDown Width="80" Value="{Binding ReferenceGainDb, Mode=TwoWay}"
                                 Minimum="-24" Maximum="24" Increment="0.5" FormatString="0.0"
                                 Margin="0,0,8,0"/>
                  <TextBlock Text="Slot" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10"
                             Foreground="{StaticResource CatppuccinSubtext0}"/>
                  <ComboBox Width="70" SelectedIndex="{Binding ActiveReferenceSlot, Mode=TwoWay}" Margin="0,0,6,0">
                    <ComboBoxItem Content="A"/>
                    <ComboBoxItem Content="B"/>
                  </ComboBox>
                  <Button Content="Browse B" Click="OnBrowseReferenceB"
                          Background="{StaticResource CatppuccinSurface1}"/>
                </WrapPanel>
                <TextBlock Text="{Binding ActiveReferenceName}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ReferenceMatchText}" FontSize="10"
                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                <TextBlock Text="{Binding ReferenceLegendText}" FontSize="10"
                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                <Canvas Height="64" Width="240" ClipToBounds="True" HorizontalAlignment="Left"
                        Background="{StaticResource CatppuccinMantle}"
                        IsVisible="{Binding HasReference}">
                  <Polyline Points="{Binding LiveSpectrumPoints}" Stroke="{StaticResource CatppuccinSapphire}"
                            StrokeThickness="1"/>
                  <Polyline Points="{Binding ReferenceSpectrumPoints}" Stroke="{StaticResource CatppuccinPeach}"
                            StrokeThickness="1"/>
                </Canvas>
                <TextBlock Text="{Binding ActiveWorkflowTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ActiveWorkflowDescription}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
                <ItemsControl ItemsSource="{Binding WorkflowStepItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="fx:WorkflowStepItem">
                      <Button Content="{Binding Label}" CommandParameter="{Binding}"
                              x:CompileBindings="False"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectWorkflowStepCommand}"
                              HorizontalContentAlignment="Left" Background="Transparent"
                              Padding="2" FontSize="11"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{DynamicResource Mastering_OpenGuide}" Click="OnOpenMasteringGuide"
                        HorizontalAlignment="Left" Background="{StaticResource CatppuccinSurface1}"/>
              </StackPanel>
            </Expander>

          </StackPanel>
        </StackPanel>

        <Panel>
        <ItemsControl Name="EffectList" ItemsSource="{Binding Effects}">
            <ItemsControl.DataTemplates>
                <!-- EQ: interactive parametric-EQ graph. -->
                <DataTemplate DataType="fx:EqEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <Border CornerRadius="4" ClipToBounds="True"
                                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                <controls:EqGraphControl Height="180"
                                                         Eq="{Binding Eq}"
                                                         Source="{Binding Source}"/>
                            </Border>
                            <TextBlock FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"
                                       Text="{DynamicResource EffectChain_Double_click_to_add_a_band_drag_to_move_wheel_fo}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Field: custom surface and/or modular node-graph editor. -->
                <DataTemplate DataType="fx:FieldEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <!-- Hide generic params when the custom surface already shows them. -->
                            <panels:ParametersView DataContext="{Binding Parameters}"
                                                   IsVisible="{Binding !HasCustomFieldSurface}"/>
                            <Border CornerRadius="4" ClipToBounds="True" IsVisible="{Binding ShowFieldSurface}"
                                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                    <fieldControls:FieldSurfaceCanvas DataContext="{Binding FieldSurface}"/>
                                </ScrollViewer>
                            </Border>
                            <Border CornerRadius="4" ClipToBounds="True" IsVisible="{Binding ShowFieldEditor}" Height="380"
                                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                <field:FieldEditorView DataContext="{Binding FieldEditor}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Filter: card with the analyser graph above the knobs. -->
                <DataTemplate DataType="fx:FilterEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <Border CornerRadius="4" ClipToBounds="True"
                                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                <controls:FilterResponseControl Height="120"
                                                                SampleRate="{Binding SampleRate}"
                                                                Source="{Binding Source}"
                                                                Frequency="{Binding FrequencyParam.Value, Mode=TwoWay}"
                                                                Resonance="{Binding ResonanceParam.Value, Mode=TwoWay}"
                                                                Mode="{Binding ModeParam.SelectedIndex}"/>
                            </Border>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Sidechain: a source picker (Tempo / a track) above the generic knobs. -->
                <DataTemplate DataType="fx:SidechainEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{DynamicResource EffectChain_Source}" VerticalAlignment="Center" Width="50"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                                <ComboBox Width="200" ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="fx:SourceTrackOption">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Compressor: optional sidechain source above threshold/ratio knobs. -->
                <DataTemplate DataType="fx:CompressorEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSidechainPicker}">
                                <TextBlock Text="{DynamicResource EffectChain_Sidechain}" VerticalAlignment="Center" Width="60"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                                <ComboBox Width="200" ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="fx:SourceTrackOption">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Live Difference: pick a track to subtract (vocal isolation), then the Amount/Output knobs. -->
                <DataTemplate DataType="fx:LiveDifferenceEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{DynamicResource EffectChain_Subtract}" VerticalAlignment="Center" Width="50"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                                <ComboBox Width="200" ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="fx:SourceTrackOption">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource CatppuccinSubtext0}"
                                       Text="{DynamicResource EffectChain_out_in_Amount_source_For_vocal_isolation_subtrac}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Vocoder: a carrier-track picker above the generic knobs. -->
                <DataTemplate DataType="fx:VocoderEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{DynamicResource EffectChain_Carrier}" VerticalAlignment="Center" Width="50"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                                <ComboBox Width="200" ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="fx:SourceTrackOption">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Stuttero: gestures, a shared curve editor, and the reorderable FX rack. -->
                <DataTemplate DataType="fx:StutteroEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <panels:EffectHeaderView/>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>

                            <!-- Auto-mode gesture + gesture list -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{DynamicResource EffectChain_Auto_gesture}" VerticalAlignment="Center" Width="80"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                                <ComboBox Width="180" ItemsSource="{Binding AutoGestureOptions}"
                                          SelectedIndex="{Binding AutoGestureIndex, Mode=TwoWay}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="200,*" Height="190">
                                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <Button Content="{DynamicResource EffectChain_Gesture}" Command="{Binding AddGestureCommand}"
                                                Background="{StaticResource CatppuccinSurface1}"/>
                                        <Button Content="{DynamicResource EffectChain_Text}" Command="{Binding RemoveGestureCommand}"
                                                Background="{StaticResource CatppuccinSurface1}"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Gestures}"
                                             SelectedItem="{Binding SelectedGesture, Mode=TwoWay}"
                                             Background="{StaticResource CatppuccinMantle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="fx:GestureItemViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <TextBlock Text="{Binding TriggerKeyName}" FontSize="10"
                                                               Foreground="{StaticResource CatppuccinOverlay1}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <!-- Selected gesture detail -->
                                <ScrollViewer Grid.Column="1">
                                    <StackPanel Spacing="6" IsVisible="{Binding HasSelectedGesture}"
                                                DataContext="{Binding SelectedGesture}">
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                                              x:DataType="fx:GestureItemViewModel">
                                            <TextBlock Text="{DynamicResource EffectChain_Name}" Grid.Row="0" Grid.Column="0" Width="70"
                                                       VerticalAlignment="Center" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                            <TextBox Text="{Binding Name, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8" x:DataType="fx:GestureItemViewModel">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource EffectChain_Rate}" FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                                <ComboBox Width="80" ItemsSource="{Binding RateOptions}"
                                                          SelectedIndex="{Binding RateIndex, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource EffectChain_Buffer}" FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"/>
                                                <ComboBox Width="90" ItemsSource="{Binding BufferOptions}"
                                                          SelectedIndex="{Binding BufferModeIndex, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:DataType="fx:GestureItemViewModel">
                                            <TextBlock FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"
                                                       Text="{Binding TriggerKeyName, StringFormat='Trigger key: {0}'}"/>
                                            <Slider Minimum="-1" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding TriggerKey, Mode=TwoWay}"/>
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource EffectChain_Buffer_length_beats}" FontSize="10"
                                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                                    <Slider Minimum="0.0625" Maximum="4" Value="{Binding BufferLengthBeats, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource EffectChain_Tail_ms}" FontSize="10"
                                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                                    <Slider Minimum="0" Maximum="120" Value="{Binding TailMs, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Curve editor + target/preset toolbar -->
                            <StackPanel Spacing="4" IsVisible="{Binding HasSelectedGesture}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox Width="150" ItemsSource="{Binding CurveTargets}"
                                              SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="fx:CurveTargetViewModel">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Width="110" ItemsSource="{Binding CurvePresets}"
                                              SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}"/>
                                    <Button Content="{DynamicResource EffectChain_Apply}" Command="{Binding ApplyPresetCommand}"
                                            Background="{StaticResource CatppuccinSurface1}"/>
                                    <CheckBox Content="{DynamicResource EffectChain_Palindrome}" IsChecked="{Binding Palindrome, Mode=TwoWay}"/>
                                    <Button Content="{DynamicResource EffectChain_Clear}" Command="{Binding ClearCurveCommand}"
                                            IsEnabled="{Binding CanClearCurve}"
                                            Background="{StaticResource CatppuccinSurface1}"/>
                                </StackPanel>
                                <Border CornerRadius="4" ClipToBounds="True" Height="150"
                                        BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1"
                                        Background="{StaticResource CatppuccinMantle}">
                                    <controls:CurveEditorControl Curve="{Binding EditCurve}"
                                                                 Revision="{Binding CurveRevision}"
                                                                 SnapDivisions="16"/>
                                </Border>
                                <TextBlock FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"
                                           Text="{DynamicResource EffectChain_Double_click_to_add_a_node_drag_to_move_drag_a_s}"/>
                            </StackPanel>

                            <!-- Reorderable FX rack -->
                            <TextBlock Text="{DynamicResource EffectChain_FX_rack_top_first}" FontWeight="Bold" FontSize="11"
                                       Foreground="{StaticResource CatppuccinOverlay1}"/>
                            <ItemsControl ItemsSource="{Binding Modules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="fx:ModuleItemViewModel">
                                        <Border Margin="0,0,0,4" Padding="6" CornerRadius="3"
                                                Background="{StaticResource CatppuccinMantle}"
                                                BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="▲" Command="{Binding MoveUpCommand}"
                                                            IsEnabled="{Binding !IsFirst}" Padding="6,0" Margin="2,0"
                                                            Background="{StaticResource CatppuccinSurface1}"/>
                                                    <Button Grid.Column="3" Content="▼" Command="{Binding MoveDownCommand}"
                                                            IsEnabled="{Binding !IsLast}" Padding="6,0"
                                                            Background="{StaticResource CatppuccinSurface1}"/>
                                                </Grid>
                                                <Expander Header="{DynamicResource EffectChain_parameters}" IsVisible="{Binding IsEnabled}">
                                                    <panels:ParametersView DataContext="{Binding Parameters}"/>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- 3D Scope: a pass-through effect whose card is a GPU 3D waveform visualization. -->
                <DataTemplate DataType="fx:WaveformVisualizerEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <Border Height="240" CornerRadius="4" ClipToBounds="True"
                                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                <controls:Engine3DVisualHost VisualizationFactory="{Binding VisualizationFactory}"
                                                             Title="{Binding Name}"/>
                            </Border>
                            <TextBlock FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"
                                       Text="{DynamicResource EffectChain_Pass_through_scope_drag_to_orbit_scroll_to_zoom_}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Spectrum: live analyser graph (pass-through). -->
                <DataTemplate DataType="fx:SpectrumEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <Border CornerRadius="4" ClipToBounds="True"
                                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                <controls:WaveCandyPanelControl Height="220"
                                    SpectrumSource="{Binding Source}"
                                    WaveformSource="{Binding Waveform}"
                                    AnalyzerSource="{Binding Analyzer}"/>
                            </Border>
                            <TextBlock FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"
                                       Text="{DynamicResource EffectChain_Spectrum_passthrough}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Tool: gain/pan/mono/phase with live peak + correlation meters. -->
                <DataTemplate DataType="fx:ToolEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Spacing="6" IsVisible="{Binding !IsCollapsed}">
                                <panels:ParametersView DataContext="{Binding Parameters}"/>
                                <Border CornerRadius="4" ClipToBounds="True"
                                        BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                    <controls:WaveCandyPanelControl Height="56"
                                        AnalyzerSource="{Binding Analyzer}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Loudness Meter: dedicated BS.1770 analyser insert. -->
                <DataTemplate DataType="fx:LoudnessMeterEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Spacing="4" IsVisible="{Binding !IsCollapsed}">
                                <TextBlock Text="{Binding ReadoutText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource CatppuccinGreen}"/>
                                <TextBlock Text="{Binding Hint}" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Tuner: large note readout (pass-through). -->
                <DataTemplate DataType="fx:TunerEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Spacing="6" IsVisible="{Binding !IsCollapsed}">
                            <Border CornerRadius="4" Padding="16" MinHeight="96"
                                    Background="{StaticResource CatppuccinCrust}"
                                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding DetectedNote}" FontSize="36" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource CatppuccinMauve}"/>
                                    <TextBlock Text="{Binding DetectedHzText}" FontSize="14"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"
                                       Text="Monophonic pitch detection on the incoming signal."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Convolution: IR loader + decay/size/mix knobs. -->
                <DataTemplate DataType="fx:ConvolutionEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Load impulse" Click="OnLoadImpulse"
                                        Background="{StaticResource CatppuccinSurface1}"/>
                                <TextBlock Text="{Binding ImpulseName}" VerticalAlignment="Center"
                                           MaxWidth="280" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource CatppuccinSubtext0}"/>
                            </StackPanel>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <TextBlock FontSize="10" Foreground="{StaticResource CatppuccinSubtext0}"
                                       Text="Load a mono WAV impulse, or use Decay/Size for a synthetic IR."/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="fx:MatchEqEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource CatppuccinPeach}"/>
                            <Canvas Height="48" Width="160" ClipToBounds="True"
                                    Background="{StaticResource CatppuccinMantle}">
                                <Line StartPoint="0,24" EndPoint="160,24" Stroke="{StaticResource CatppuccinSurface2}"/>
                                <Polyline Points="{Binding DeltaCurve}" Stroke="{StaticResource CatppuccinMauve}"
                                          StrokeThickness="1.5"/>
                            </Canvas>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <TextBlock Text="{Binding Hint}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="fx:LinearPhaseEqEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <TextBlock Text="{Binding LatencyText}" FontSize="11"
                                       Foreground="{StaticResource CatppuccinPeach}"/>
                            <Canvas Height="48" Width="160" ClipToBounds="True"
                                    Background="{StaticResource CatppuccinMantle}">
                                <Line StartPoint="0,24" EndPoint="160,24" Stroke="{StaticResource CatppuccinSurface2}"/>
                                <Polyline Points="{Binding ResponseCurve}" Stroke="{StaticResource CatppuccinSapphire}"
                                          StrokeThickness="1.5"/>
                            </Canvas>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <TextBlock Text="{Binding Hint}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Mid/Side EQ mastering card -->
                <DataTemplate DataType="fx:MidSideEqEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton Content="{DynamicResource Mastering_SoloMid}" IsChecked="{Binding SoloMid}" Padding="8,2"/>
                                <ToggleButton Content="{DynamicResource Mastering_SoloSide}" IsChecked="{Binding SoloSide}" Padding="8,2"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="Mid" FontSize="10"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MidEnergy}" Height="8"/>
                                <TextBlock Grid.Column="2" Text="Side" FontSize="10"/>
                                <ProgressBar Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding SideEnergy}" Height="8"/>
                            </Grid>
                            <Canvas Height="40" Width="160" ClipToBounds="True"
                                    Background="{StaticResource CatppuccinMantle}">
                                <Polyline Points="{Binding SideResponseCurve}" Stroke="{StaticResource CatppuccinMauve}"
                                          StrokeThickness="1.5"/>
                            </Canvas>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Text="{Binding Hint}"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="fx:MultibandCompressorEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <TextBlock Text="{Binding BandInfo}" FontSize="11"
                                       Foreground="{StaticResource CatppuccinOverlay1}"/>
                            <TextBlock Text="{Binding PresetHint}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource CatppuccinOverlay1}"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                <StackPanel Grid.Column="0"><TextBlock Text="{DynamicResource Mastering_Band_Low}" HorizontalAlignment="Center"/><ProgressBar Value="{Binding LowEnergy}" Maximum="1" Height="28"/><TextBlock Text="{Binding LowGr}" HorizontalAlignment="Center" FontSize="9"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Mastering_Band_Mid}" HorizontalAlignment="Center"/><ProgressBar Value="{Binding MidEnergy}" Maximum="1" Height="28"/><TextBlock Text="{Binding MidGr}" HorizontalAlignment="Center" FontSize="9"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Mastering_Band_High}" HorizontalAlignment="Center"/><ProgressBar Value="{Binding HighEnergy}" Maximum="1" Height="28"/><TextBlock Text="{Binding HighGr}" HorizontalAlignment="Center" FontSize="9"/></StackPanel>
                            </Grid>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="fx:ClipperEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Canvas Grid.Column="0" Height="48" ClipToBounds="True" Background="{StaticResource CatppuccinMantle}">
                                    <Polyline Points="{Binding TransferCurve}" Stroke="{StaticResource CatppuccinMauve}" StrokeThickness="1.5"/>
                                </Canvas>
                                <Canvas Grid.Column="1" Height="40" ClipToBounds="True" Background="{StaticResource CatppuccinMantle}">
                                    <Polyline Points="{Binding RecentWaveform}" Stroke="{StaticResource CatppuccinGreen}" StrokeThickness="1"/>
                                    <Line StartPoint="0,0" EndPoint="128,0" Canvas.Top="{Binding CeilingY}"
                                          Stroke="{StaticResource CatppuccinPeach}" StrokeThickness="1"/>
                                    <Line StartPoint="0,0" EndPoint="128,0" Canvas.Top="{Binding CeilingBottomY}"
                                          Stroke="{StaticResource CatppuccinPeach}" StrokeThickness="1"/>
                                </Canvas>
                            </Grid>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Text="{Binding Hint}"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="fx:StereoWidthEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <ProgressBar Minimum="0" Maximum="1" Height="8" Value="{Binding WidthNormalized}"
                                         Foreground="{StaticResource CatppuccinMauve}"
                                         Background="{StaticResource CatppuccinSurface1}"/>
                            <ProgressBar Minimum="0" Maximum="1" Height="8" Value="{Binding CorrelationNormalized}"
                                         Foreground="{StaticResource CatppuccinGreen}" Background="{StaticResource CatppuccinRed}"/>
                            <TextBlock Text="{Binding CorrelationText}" FontSize="10"/>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Text="{Binding Hint}"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="fx:PeakLimiterEffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <TextBlock Text="{Binding PresetHint}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource CatppuccinOverlay1}"/>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <Canvas Height="28" ClipToBounds="True" Background="{StaticResource CatppuccinMantle}">
                                <Polyline Points="{Binding PeakHistory}" Stroke="{StaticResource CatppuccinPeach}" StrokeThickness="1.5"/>
                                <Line StartPoint="0,3" EndPoint="128,3" Stroke="{StaticResource CatppuccinRed}" StrokeThickness="1"/>
                                <Line StartPoint="0,0" EndPoint="128,0" Canvas.Top="{Binding DeliveryCeilingY}"
                                      Stroke="{StaticResource CatppuccinMauve}" StrokeThickness="1"/>
                            </Canvas>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding OutputLevel}" Height="8"
                                         Foreground="{StaticResource CatppuccinGreen}"/>
                            <TextBlock Text="{Binding CeilingLine}" FontSize="10"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- Default effect card (built-in effects + CLAP audio-effect plugins). -->
                <DataTemplate DataType="fx:EffectViewModel">
                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="4"
                            Background="{StaticResource CatppuccinSurface0}"
                            BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <panels:EffectHeaderView/>
                            <panels:ParametersView DataContext="{Binding Parameters}"/>
                            <Button Content="{Binding EditorButtonText}" IsVisible="{Binding HasEditor}"
                                    Click="OnToggleEffectPluginUi" HorizontalAlignment="Left"
                                    Background="{StaticResource CatppuccinSurface1}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>

        <!-- Drag-drop indicators (positioned in code-behind): a replace highlight + an insertion line. -->
        <Canvas Name="DropOverlay" IsHitTestVisible="False">
            <Border Name="DropReplace" IsVisible="False" CornerRadius="4" BorderThickness="2"
                    BorderBrush="{StaticResource CatppuccinMauve}" Background="#33CBA6F7"/>
            <Border Name="DropLine" IsVisible="False" Height="2"
                    Background="{StaticResource CatppuccinMauve}"/>
        </Canvas>
        </Panel>
    </DockPanel>
</UserControl>
