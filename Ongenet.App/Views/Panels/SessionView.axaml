<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ongenet.App.ViewModels.Panels"
             xmlns:controls="using:Ongenet.App.Controls"
             xmlns:sched="using:Ongenet.Core.Audio.Scheduling"
             x:Class="Ongenet.App.Views.Panels.SessionView"
             x:DataType="vm:SessionViewModel">
    <UserControl.Styles>
        <Style Selector="Button.slot">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
            <Setter Property="Foreground" Value="{StaticResource CatppuccinText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinSurface2}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.slot.empty">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.slot.empty.assignable">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinBlue}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.slot.playing">
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinGreen}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.slot.queued">
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinYellow}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.slot:selected">
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinBlue}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.scene">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CatppuccinCrust}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,220" Background="{StaticResource CatppuccinBase}">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,4" Spacing="8">
                <TextBlock Text="{DynamicResource Session_Session}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource CatppuccinText}" VerticalAlignment="Center"/>
                <Button Classes="compact" Content="{DynamicResource Session_Stop_All}" Command="{Binding StopAllCommand}"/>
                <Button Classes="compact" Content="{DynamicResource Session_Capture}" Command="{Binding CaptureCommand}"
                        ToolTip.Tip="{DynamicResource Session_Materialize_session_launches_to_the_arrangement_Tip}"/>
                <TextBlock Text="{Binding PendingCaptureCount, StringFormat='({0} pending)'}"
                           FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinOverlay1}"
                           IsVisible="{Binding !!PendingCaptureCount}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8" Spacing="8">
                <TextBlock Text="{DynamicResource Session_Crossfader}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
                <TextBlock Text="{DynamicResource Session_Arr}" FontSize="9" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinOverlay0}"/>
                <Slider Classes="compact" Minimum="0" Maximum="1" Width="140" Value="{Binding SessionCrossfader}"
                        TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{DynamicResource Session_Ses}" FontSize="9" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinOverlay0}"/>
                <TextBlock Text="{DynamicResource Session_Quantize}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
                <ComboBox SelectedIndex="{Binding ProjectLaunchQuantizeIndex}" Width="100" FontSize="11">
                    <ComboBoxItem Content="{DynamicResource Session_Off}"/>
                    <ComboBoxItem Content="{DynamicResource Session_N1_16}"/>
                    <ComboBoxItem Content="{DynamicResource Session_N1_8}"/>
                    <ComboBoxItem Content="{DynamicResource Session_N1_4}"/>
                    <ComboBoxItem Content="{DynamicResource Session_N1_2}"/>
                    <ComboBoxItem Content="{DynamicResource Session_N1_bar}"/>
                </ComboBox>
            </StackPanel>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Margin="8">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Border Width="120" MinHeight="32" Margin="2"
                                Background="{StaticResource CatppuccinMantle}" CornerRadius="4">
                            <TextBlock Text="{DynamicResource Session_Scenes}" Margin="8,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource CatppuccinOverlay1}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SceneColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionSceneColumnViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="scene" Content="{Binding Label}"
                                                Background="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                                                Command="{Binding LaunchCommand}" ToolTip.Tip="{DynamicResource Session_Launch_scene_Tip}"/>
                                        <Button Content="{DynamicResource Session_Text}" FontSize="9" Padding="6,2" Margin="0,2,2,2"
                                                Command="{Binding StopCommand}" ToolTip.Tip="{DynamicResource Session_Stop_scene_Tip}"
                                                Background="{StaticResource CatppuccinSurface1}"
                                                Foreground="{StaticResource CatppuccinRed}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding TrackRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionTrackRowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Border Width="120" MinHeight="56" Margin="2" CornerRadius="4"
                                            Background="{StaticResource CatppuccinMantle}"
                                            BorderBrush="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                                            BorderThickness="3,0,0,0">
                                        <TextBlock Text="{Binding TrackName}" Margin="8,0" VerticalAlignment="Center"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource CatppuccinText}"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SessionSlotViewModel">
                                                <controls:SessionSlotButton Classes="slot" Classes.empty="{Binding IsEmpty}"
                                                        Classes.assignable="{Binding CanAssignSource}"
                                                        Classes.playing="{Binding IsPlaying}"
                                                        Classes.queued="{Binding IsQueued}"
                                                        Classes.selected="{Binding IsSelected}"
                                                        ToolTip.Tip="{DynamicResource Session_Shift_click_inspect_Tip}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource Session_Launch}" Command="{Binding LaunchCommand}"
                                                                      IsVisible="{Binding !IsEmpty}"/>
                                                            <MenuItem Header="{DynamicResource Session_Assign_selected_clip}"
                                                                      Command="{Binding AssignFromSelectedCommand}"
                                                                      IsVisible="{Binding IsEmpty}"/>
                                                            <MenuItem Header="{DynamicResource Session_Queue}" Command="{Binding QueueCommand}"
                                                                      IsVisible="{Binding !IsEmpty}"/>
                                                            <MenuItem Header="{DynamicResource Session_Stop}" Command="{Binding StopCommand}"
                                                                      IsVisible="{Binding !IsEmpty}"/>
                                                            <MenuItem Header="{DynamicResource Session_Inspect}" Command="{Binding SelectCommand}"
                                                                      IsVisible="{Binding !IsEmpty}"/>
                                                            <MenuItem Header="{DynamicResource Session_Clear_slot}" Command="{Binding ClearSlotCommand}"
                                                                      IsVisible="{Binding !IsEmpty}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource CatppuccinText}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                                    IsVisible="{Binding !IsEmpty}">
                                                            <TextBlock Text="▶" FontSize="9" Opacity="0.7"
                                                                       Foreground="{StaticResource CatppuccinOverlay1}"/>
                                                            <TextBlock Text="{DynamicResource Session_Q}" FontSize="9"
                                                                       IsVisible="{Binding IsQueued}"
                                                                       Foreground="{StaticResource CatppuccinYellow}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </controls:SessionSlotButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Session clip inspector -->
        <Border Grid.Column="1" Margin="0,8,8,8" Padding="12" CornerRadius="6"
                Background="{StaticResource CatppuccinMantle}"
                BorderBrush="{StaticResource CatppuccinSurface2}" BorderThickness="1"
                IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource Session_Clip}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource CatppuccinText}"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Session_Name}" FontSize="10" Foreground="{StaticResource CatppuccinOverlay1}"/>
                    <TextBox Text="{Binding InspectorName}" FontSize="11"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Session_Source}" FontSize="10" Foreground="{StaticResource CatppuccinOverlay1}"/>
                    <TextBlock Text="{Binding InspectorSourceName}" FontSize="11"
                               Foreground="{StaticResource CatppuccinText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Session_Length}" FontSize="10" Foreground="{StaticResource CatppuccinOverlay1}"/>
                    <NumericUpDown Value="{Binding InspectorLengthBeats}" Minimum="0.25" Increment="0.25"
                                     FormatString="0.##" FontSize="11"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Session_Launch_mode}" FontSize="10" Foreground="{StaticResource CatppuccinOverlay1}"/>
                    <ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding LaunchMode}"
                              HorizontalAlignment="Stretch" FontSize="11"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Session_Quantize}" FontSize="10" Foreground="{StaticResource CatppuccinOverlay1}"/>
                    <ComboBox SelectedIndex="{Binding LaunchQuantizeIndex}" HorizontalAlignment="Stretch" FontSize="11">
                        <ComboBoxItem Content="{DynamicResource Session_Project_default}"/>
                        <ComboBoxItem Content="{DynamicResource Session_N1_16_note}"/>
                        <ComboBoxItem Content="{DynamicResource Session_N1_8_note}"/>
                        <ComboBoxItem Content="{DynamicResource Session_N1_4_note}"/>
                        <ComboBoxItem Content="{DynamicResource Session_N1_2_note}"/>
                        <ComboBoxItem Content="{DynamicResource Session_N1_bar}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Session_Follow_action}" FontSize="10" Foreground="{StaticResource CatppuccinOverlay1}"/>
                    <ComboBox ItemsSource="{Binding FollowActions}" SelectedItem="{Binding FollowAction}"
                              HorizontalAlignment="Stretch" FontSize="11"/>
                </StackPanel>
                <Button Classes="compact" Content="{DynamicResource Session_Clear_slot}"
                        Command="{Binding ClearSelectedSlotCommand}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
