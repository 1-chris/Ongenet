<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ongenet.App.ViewModels.Panels"
             xmlns:panels="using:Ongenet.App.Views.Panels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="200"
             x:Class="Ongenet.App.Views.Panels.MidiFxView"
             x:DataType="vm:MidiFxViewModel">

    <Border Background="{StaticResource CatppuccinMantle}" Padding="12">
        <Grid>
            <TextBlock Text="{DynamicResource MidiFx_Select_a_track_to_add_MIDI_effects}" IsVisible="{Binding !HasTrack}"
                       Foreground="{StaticResource CatppuccinSubtext0}" VerticalAlignment="Top"/>

            <StackPanel IsVisible="{Binding HasTrack}" Spacing="10">
                <TextBlock Text="{Binding TrackName, StringFormat='{}{0} — MIDI FX chain'}"
                           Foreground="{StaticResource CatppuccinSubtext0}"/>

                <ItemsControl ItemsSource="{Binding Available}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AvailableMidiEffectViewModel">
                            <Button Classes="compact" Margin="0,0,6,6"
                                    Content="{Binding DisplayName}"
                                    Command="{Binding AddCommand}"
                                    ToolTip.Tip="{Binding Category}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Effects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MidiEffectSlotViewModel">
                            <Border Margin="0,4,0,0" Padding="8" CornerRadius="4"
                                    Background="{StaticResource CatppuccinSurface0}">
                                <StackPanel Spacing="8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="compact" Content="{Binding Status}" Command="{Binding ToggleCommand}"/>
                                            <Button Classes="compact" Content="{DynamicResource MidiFx_Text}" Command="{Binding RemoveCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource CatppuccinText}"/>
                                    </DockPanel>
                                    <panels:ParametersView DataContext="{Binding Parameters}"
                                                           IsVisible="{Binding HasParameters}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
