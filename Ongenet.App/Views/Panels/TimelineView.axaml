<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ongenet.App.ViewModels"
             xmlns:tl="using:Ongenet.App.ViewModels.Timeline"
             xmlns:controls="using:Ongenet.App.Controls"
             xmlns:Automation="using:Avalonia.Automation"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="Ongenet.App.Views.Panels.TimelineView"
             x:DataType="vm:TimelineViewModel"
             Automation:AutomationProperties.Name="{DynamicResource Timeline_Timeline_A11yName}"
             Automation:AutomationProperties.HelpText="{DynamicResource Timeline_Arrangement_timeline_with_track_lanes_and_clips}">

    <UserControl.Resources>
        <x:Double x:Key="GutterBarWidth">4</x:Double>
        <x:Double x:Key="RulerHeight">26</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.clip">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinCrust}"/>
        </Style>
        <Style Selector="Border.clip.selected">
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinText}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.group-summary">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinOverlay1}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Border.pattern-clip">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinText}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="Border.pattern-clip.selected">
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinText}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource CatppuccinCrust}">
        <!-- Row 0/1 reserved for a future video-reference strip; arrangement fills all rows for now. -->
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- timeline grid -->
        <Grid Grid.Row="0" Grid.RowSpan="3" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

            <!-- [0,0] corner above the headers -->
            <Border Grid.Row="0" Grid.Column="0"
                    Width="{Binding Metrics.HeaderWidth}" Height="{StaticResource RulerHeight}"
                    Background="{StaticResource CatppuccinMantle}"
                    BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,0,1,1">
                <TextBlock Text="{DynamicResource Timeline_Tracks}" Margin="8,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource CatppuccinOverlay1}"/>
            </Border>

            <!-- [0,1] ruler — scroll driven horizontally by the lanes -->
            <ScrollViewer Grid.Row="0" Grid.Column="1" Name="RulerScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Background="{StaticResource CatppuccinMantle}">
                <!-- Sized explicitly so Canvas panels have room; left-aligned so ticks don't centre
                     (and drift from the lanes) when the viewport is wider than the arrangement. -->
                <Grid HorizontalAlignment="Left"
                      Width="{Binding Metrics.TotalWidth}" Height="{StaticResource RulerHeight}">
                    <ItemsControl ItemsSource="{Binding Bars}"
                                  Width="{Binding Metrics.TotalWidth}" Height="{StaticResource RulerHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="tl:BarTickViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="0"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tl:BarTickViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4" Height="26"
                                            IsVisible="{Binding IsLabelVisible}">
                                    <Rectangle Width="1" Fill="{StaticResource CatppuccinSurface2}"/>
                                    <TextBlock Text="{Binding BarNumber}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,0,1"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Named arrangement markers sit in the scrolling ruler so labels stay aligned. -->
                    <ItemsControl Name="RulerMarkers" ItemsSource="{Binding Markers}"
                                  Width="{Binding Metrics.TotalWidth}" Height="{StaticResource RulerHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="tl:ArrangementMarkerViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="0"/>
                                <Setter Property="ZIndex" Value="1"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tl:ArrangementMarkerViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="2" Margin="-4,1,0,0"
                                            Background="Transparent"
                                            ToolTip.Tip="{DynamicResource Timeline_Marker_Tip}"
                                            DoubleTapped="Marker_DoubleTapped"
                                            PointerPressed="Marker_PointerPressed">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Timeline_Rename}"
                                                      Tag="{Binding}"
                                                      Click="MarkerRename_Click"/>
                                            <MenuItem Header="{DynamicResource Timeline_Delete_marker}"
                                                      Tag="{Binding}"
                                                      Click="MarkerDelete_Click"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Path Data="M0,0 L8,0 L4,8 Z" Fill="{StaticResource CatppuccinYellow}"
                                          Width="8" Height="8" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Top" Margin="0,1,0,0"
                                               Foreground="{StaticResource CatppuccinYellow}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- [1,0] track headers — scroll driven vertically by the lanes -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" Name="HeaderScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          Background="{StaticResource CatppuccinMantle}">
                <ItemsControl ItemsSource="{Binding Lanes}" Width="{Binding Metrics.HeaderWidth}">
                    <ItemsControl.Styles>
                        <Style Selector="Border.selected">
                            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
                        </Style>
                        <Style Selector="Button.chev">
                            <Setter Property="Width" Value="16"/>
                            <Setter Property="Height" Value="16"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource CatppuccinSubtext0}"/>
                        </Style>
                        <Style Selector="Button.xbtn">
                            <Setter Property="Width" Value="16"/>
                            <Setter Property="Height" Value="16"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource CatppuccinOverlay1}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.DataTemplates>
                        <!-- Track header -->
                        <DataTemplate DataType="tl:TrackLaneViewModel">
                            <!-- No bottom border here; the inter-row divider is drawn over the content only
                                 (below) so the gutter colour rails stay continuous between grouped rows. -->
                            <Border Height="{Binding Height}" BorderBrush="{StaticResource CatppuccinCrust}"
                                    BorderThickness="0,0,1,0"
                                    Classes.selected="{Binding IsSelected}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Timeline_Group_tracks}" Command="{Binding GroupTracksCommand}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Detach_from_group}" Command="{Binding DetachFromGroupCommand}"
                                                  IsVisible="{Binding IsInGroup}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Duplicate}" Command="{Binding DuplicateCommand}"
                                                  IsVisible="{Binding !IsBus}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Delete}" Command="{Binding DeleteCommand}"
                                                  IsVisible="{Binding !IsBus}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Delete_group_keep_tracks}" Command="{Binding DeleteGroupKeepChildrenCommand}"
                                                  IsVisible="{Binding IsGroup}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Delete_group_child_tracks}" Command="{Binding DeleteGroupAndChildrenCommand}"
                                                  IsVisible="{Binding IsGroup}"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Timeline_Add_Instrument_Track}" Command="{Binding AddInstrumentTrackCommand}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Add_Audio_Track}" Command="{Binding AddAudioTrackCommand}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Add_Hybrid_Track}" Command="{Binding AddHybridTrackCommand}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Add_Pattern_Track}" Command="{Binding AddPatternTrackCommand}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <!-- Transparent fill makes the whole header row clickable for selection
                                     (the row Border's own background is reserved for the selected highlight). -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                    <!-- colour rails: one per nesting level (ancestor groups + own); a group's
                                         colour forms a continuous rail down through all its descendants. -->
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding GutterBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tl:LaneGutterBar">
                                                <Border Width="{StaticResource GutterBarWidth}" Background="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Grid.Column="1" Margin="8,6" RowDefinitions="Auto,Auto" VerticalAlignment="Center"
                                          IsVisible="{Binding !IsCompact}">
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="3">
                                            <Button Classes="chev" Content="{Binding CollapseGlyph}"
                                                    ToolTip.Tip="{DynamicResource Timeline_Collapse_expand_Tip}"
                                                    IsVisible="{Binding ShowCollapse}"
                                                    Command="{Binding ToggleCollapseCommand}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5"
                                                    HorizontalAlignment="Right">
                                            <ToggleButton Classes="strip" Content="{DynamicResource Timeline_M}" ToolTip.Tip="{DynamicResource Timeline_Mute_Tip}"
                                                          IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                          Foreground="{StaticResource CatppuccinRed}"/>
                                            <ToggleButton Classes="strip" Content="{DynamicResource Timeline_S}" ToolTip.Tip="{DynamicResource Timeline_Solo_Tip}"
                                                          IsChecked="{Binding IsSoloed, Mode=TwoWay}"
                                                          Foreground="{StaticResource CatppuccinYellow}"/>
                                            <ToggleButton Classes="strip record" Content="{DynamicResource Timeline_Text}" ToolTip.Tip="{DynamicResource Timeline_Arm_for_recording_Tip}"
                                                          IsChecked="{Binding IsArmed, Mode=TwoWay}"
                                                          IsVisible="{Binding !IsBus}"
                                                          Foreground="{StaticResource CatppuccinRed}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- compact: name left, controls pinned right -->
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="6,0"
                                          VerticalAlignment="Center" IsVisible="{Binding IsCompact}">
                                        <Button Grid.Column="0" Classes="chev" Content="{Binding CollapseGlyph}"
                                                ToolTip.Tip="{DynamicResource Timeline_Collapse_expand_Tip}"
                                                IsVisible="{Binding ShowCollapse}"
                                                Command="{Binding ToggleCollapseCommand}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="3,0"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                            <ToggleButton Classes="strip" Content="{DynamicResource Timeline_M}" ToolTip.Tip="{DynamicResource Timeline_Mute_Tip}"
                                                          IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                          Foreground="{StaticResource CatppuccinRed}"/>
                                            <ToggleButton Classes="strip" Content="{DynamicResource Timeline_S}" ToolTip.Tip="{DynamicResource Timeline_Solo_Tip}"
                                                          IsChecked="{Binding IsSoloed, Mode=TwoWay}"
                                                          Foreground="{StaticResource CatppuccinYellow}"/>
                                            <ToggleButton Classes="strip record" Content="{DynamicResource Timeline_Text}" ToolTip.Tip="{DynamicResource Timeline_Arm_for_recording_Tip}"
                                                          IsChecked="{Binding IsArmed, Mode=TwoWay}"
                                                          IsVisible="{Binding !IsBus}"
                                                          Foreground="{StaticResource CatppuccinRed}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- live output level -->
                                    <controls:LevelMeterControl Grid.Column="2" Width="6" Margin="0,8,6,8"
                                                                Level="{Binding MeterLevel}"/>
                                    <!-- inter-row divider, content only (keeps the gutter rails unbroken) -->
                                    <Border Grid.Column="1" Grid.ColumnSpan="2" IsHitTestVisible="False"
                                            BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,0,0,1"/>
                                    <!-- bottom-edge row height resize -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="6"
                                            Background="Transparent" Cursor="SizeNorthSouth" Classes="lane-resize"
                                            IsVisible="{Binding SupportsResize}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <!-- Automation header (indented under its track) -->
                        <DataTemplate DataType="tl:AutomationLaneViewModel">
                            <!-- No bottom border (divider drawn over the content only) so the owning track's
                                 colour rail flows unbroken down through its automation rows. -->
                            <Border Height="{Binding Height}" BorderBrush="{StaticResource CatppuccinCrust}"
                                    BorderThickness="0,0,1,0" Background="{StaticResource CatppuccinMantle}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- owning track's colour rails (plus one extra in the track's colour) continue
                                         through and indent its automation rows -->
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding GutterBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tl:LaneGutterBar">
                                                <Border Width="{StaticResource GutterBarWidth}" Background="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Grid.Column="1" Margin="6,4" RowDefinitions="Auto,Auto" VerticalAlignment="Center"
                                          IsVisible="{Binding !IsCompact}">
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="11"
                                                   Foreground="{StaticResource CatppuccinSubtext0}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ToggleButton Grid.Row="1" Classes="strip record" Content="{DynamicResource Timeline_Text}" ToolTip.Tip="{DynamicResource Timeline_Arm_to_record_control_moves_Tip}"
                                                      IsChecked="{Binding IsArmed, Mode=TwoWay}"
                                                      Foreground="{StaticResource CatppuccinRed}"
                                                      HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="6,0"
                                          VerticalAlignment="Center" IsVisible="{Binding IsCompact}">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                   Foreground="{StaticResource CatppuccinSubtext0}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <ToggleButton Grid.Column="1" Classes="strip record" Content="{DynamicResource Timeline_Text}" ToolTip.Tip="{DynamicResource Timeline_Arm_to_record_control_moves_Tip}"
                                                      IsChecked="{Binding IsArmed, Mode=TwoWay}"
                                                      Foreground="{StaticResource CatppuccinRed}"/>
                                    </Grid>
                                    <Button Grid.Column="2" Classes="xbtn" Content="{DynamicResource Timeline_Text_2}" ToolTip.Tip="{DynamicResource Timeline_Remove_automation_Tip}"
                                            VerticalAlignment="Top" Margin="0,4,4,0"
                                            Command="{Binding RemoveCommand}"/>
                                    <!-- inter-row divider, content only (keeps the gutter rail unbroken) -->
                                    <Border Grid.Column="1" Grid.ColumnSpan="2" IsHitTestVisible="False"
                                            BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="6"
                                            Background="Transparent" Cursor="SizeNorthSouth" Classes="lane-resize"
                                            IsVisible="{Binding SupportsResize}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <!-- Take lane header -->
                        <DataTemplate DataType="tl:TakeLaneViewModel">
                            <Border Height="{Binding Height}" BorderBrush="{StaticResource CatppuccinCrust}"
                                    BorderThickness="0,0,1,0" Background="{StaticResource CatppuccinCrust}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Timeline_Promote_take}" Command="{Binding PromoteTakeCommand}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Flatten_comp}" Command="{Binding FlattenCompCommand}"/>
                                        <MenuItem Header="{DynamicResource Timeline_Split_comp_at_playhead}" Command="{Binding SplitCompAtPlayheadCommand}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="24,0,8,0" VerticalAlignment="Center">
                                    <Button Classes="chev" Content="{Binding CollapseGlyph}" Command="{Binding ToggleExpandCommand}"
                                            Width="16" Height="16" Padding="0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                               Foreground="{StaticResource CatppuccinOverlay1}"/>
                                    <TextBlock Text="{Binding CompSummary}" FontSize="9"
                                               Foreground="{StaticResource CatppuccinSubtext0}"/>
                                </StackPanel>
                                <Border VerticalAlignment="Bottom" Height="6" HorizontalAlignment="Stretch"
                                        Background="Transparent" Cursor="SizeNorthSouth" Classes="lane-resize"
                                        IsVisible="{Binding SupportsResize}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>

            <!-- [1,1] lanes — the master scroll region -->
            <ListBox Grid.Row="1" Grid.Column="1" Name="LanesList"
                     ItemsSource="{Binding Lanes}"
                     SelectedItem="{Binding SelectedLane, Mode=TwoWay}"
                     Background="Transparent"
                     DragDrop.AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <!-- Non-virtualizing panel: mixed 64px/56px row heights misalign when recycled.
                     MinWidth matches the arrange length so the internal ScrollViewer can scroll
                     horizontally (ListBoxItem containers otherwise clamp to the viewport width). -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel MinWidth="{Binding Metrics.TotalWidth}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <!-- Right-clicking blank space below the tracks offers to add a track. -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Timeline_Ripple_insert}" Command="{Binding RippleInsertCommand}"/>
                        <MenuItem Header="{DynamicResource Timeline_Ripple_delete}" Command="{Binding RippleDeleteCommand}"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Timeline_Logical_MIDI_edit}" Command="{Binding OpenLogicalMidiEditCommand}"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Timeline_Add_Instrument_Track}" Command="{Binding AddInstrumentTrackCommand}"/>
                        <MenuItem Header="{DynamicResource Timeline_Add_Audio_Track}" Command="{Binding AddAudioTrackCommand}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="MinWidth" Value="{Binding LaneWidth}"/>
                        <!-- Keep lane content pinned to the left so bar 0 sits at x=0 (a fixed-width
                             child with the default Stretch alignment would otherwise be centred when
                             the viewport is wider than the content). -->
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.DataTemplates>
                    <!-- Track lane -->
                    <DataTemplate DataType="tl:TrackLaneViewModel">
                        <Border Width="{Binding LaneWidth}" Height="{Binding Height}" HorizontalAlignment="Left"
                                BorderBrush="{StaticResource CatppuccinMantle}" BorderThickness="0,0,0,1">
                            <Grid>
                            <controls:TimelineGridControl IsHitTestVisible="False"
                                                          PixelsPerBeat="{Binding Metrics.PixelsPerBeat}"
                                                          TotalBeats="{Binding Metrics.TotalBeats}"
                                                          BeatsPerBar="{Binding Metrics.BeatsPerBar}"
                                                          HorizontalOffset="{Binding Metrics.HorizontalOffset}"/>
                            <ItemsControl ItemsSource="{Binding Clips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <!-- ItemContainerTheme styles ONLY the clip containers (not, e.g.,
                                     the context menu's content presenters, which a broad
                                     "ContentPresenter" style would have mis-sized). -->
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter" x:DataType="tl:ClipViewModel">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding $parent[ItemsControl].DataContext.ClipTopInset}"/>
                                        <Setter Property="Width" Value="{Binding Width}"/>
                                        <Setter Property="Height" Value="{Binding $parent[ItemsControl].DataContext.ClipHeight}"/>
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tl:ClipViewModel">
                                            <Border Classes="clip" CornerRadius="4" ClipToBounds="True"
                                                    Background="{Binding DisplayColorKey, Converter={StaticResource ColorKeyToBrush}}"
                                                    Classes.selected="{Binding IsSelected}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource Timeline_Rename}" Command="{Binding RenameCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Duplicate}" Command="{Binding DuplicateCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Create_linked_copy}"
                                                                  Command="{Binding CreateLinkedCopyCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Unlink}" Command="{Binding UnlinkClipCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Make_unique}" Command="{Binding MakeUniqueCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Reverse}" Command="{Binding ReverseCommand}"
                                                                  IsVisible="{Binding IsAudio}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Render_clip_to_new_track}"
                                                                  Command="{Binding RenderToNewTrackCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Open_in_Audio_Editor}"
                                                                  Command="{Binding OpenInAudioEditorCommand}"
                                                                  IsVisible="{Binding IsAudio}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Open_Pitch_Editor}"
                                                                  Command="{Binding OpenPitchEditorCommand}"
                                                                  IsVisible="{Binding IsAudio}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Open_ARA_Editor}"
                                                                  Command="{Binding OpenAraEditorCommand}"
                                                                  IsVisible="{Binding HasAraSupport}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Send_to_Session_Slot}"
                                                                  Command="{Binding SendToSessionSlotCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Convert_to_MIDI}"
                                                                  Command="{Binding ConvertToMidiCommand}"
                                                                  IsVisible="{Binding IsAudio}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Convert_to_poly_MIDI}"
                                                                  Command="{Binding ConvertToPolyMidiCommand}"
                                                                  IsVisible="{Binding IsAudio}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Separate_stems_4_way}"
                                                                  Command="{Binding SeparateStemsCommand}"
                                                                  IsVisible="{Binding IsAudio}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Bounce_in_place}"
                                                                  Command="{Binding BounceInPlaceCommand}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Logical_MIDI_edit}"
                                                                  Command="{Binding LogicalMidiEditCommand}"
                                                                  IsVisible="{Binding IsMidi}"/>
                                                        <MenuItem Header="{DynamicResource Timeline_Delete}" Command="{Binding DeleteCommand}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <controls:WaveformControl Waveform="{Binding Waveform}"
                                                                              Revision="{Binding WaveformRevision}"
                                                                              StartFraction="{Binding WaveStartFraction}"
                                                                              EndFraction="{Binding WaveEndFraction}"
                                                                              IsVisible="{Binding IsAudio}"
                                                                              IsHitTestVisible="False"
                                                                              Fill="{StaticResource CatppuccinCrust}"
                                                                              Opacity="0.55" Margin="0,3"/>
                                                    <controls:MidiNoteMiniControl Notes="{Binding Notes}"
                                                                                  ClipLengthBeats="{Binding ClipLengthBeats}"
                                                                                  Revision="{Binding NotesRevision}"
                                                                                  IsVisible="{Binding IsMidi}"
                                                                                  IsHitTestVisible="False"
                                                                                  Fill="{StaticResource CatppuccinCrust}"
                                                                                  Opacity="0.6" Margin="2,16,2,4"/>
                                                    <controls:ClipFadeControl FadeInWidth="{Binding FadeInWidth}"
                                                                              FadeOutWidth="{Binding FadeOutWidth}"
                                                                              FadeInWaveform="{Binding FadeInWaveform}"
                                                                              FadeOutWaveform="{Binding FadeOutWaveform}"
                                                                              Revision="{Binding FadeRevision}"
                                                                              IsVisible="{Binding IsAudio}"
                                                                              IsSelected="{Binding IsSelected}"
                                                                              ClipLengthBeats="{Binding ClipLengthBeats}"
                                                                              PixelsPerBeat="{Binding PixelsPerBeat}"
                                                                              ClipBackground="{Binding Owner.ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                                                                              WaveFill="{StaticResource CatppuccinCrust}"
                                                                              Stroke="Black"/>
                                                    <controls:WarpMarkerControl Markers="{Binding WarpMarkers}"
                                                                                  ClipLengthBeats="{Binding ClipLengthBeats}"
                                                                                  SourceDurationSeconds="{Binding SourceDurationSeconds}"
                                                                                  SourceOffsetSeconds="{Binding SourceOffsetSeconds}"
                                                                                  IsSelected="{Binding IsSelected}"
                                                                                  Revision="{Binding WarpRevision}"
                                                                                  IsVisible="{Binding IsAudio}"/>
                                                    <TextBlock Text="{Binding Name}" Margin="6,3" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Top"
                                                               Foreground="{StaticResource CatppuccinCrust}"/>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="4" Padding="4,1" CornerRadius="3"
                                                            IsVisible="{Binding HasAraRegion}"
                                                            IsHitTestVisible="False"
                                                            Background="{StaticResource CatppuccinMauve}"
                                                            Opacity="0.85">
                                                        <TextBlock Text="{DynamicResource Timeline_ARA}" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{StaticResource CatppuccinCrust}"/>
                                                    </Border>
                                                    <Border Width="{Binding RenderProgressWidth}"
                                                            HorizontalAlignment="Left"
                                                            IsVisible="{Binding IsRendering}"
                                                            IsHitTestVisible="False"
                                                            Background="{StaticResource CatppuccinGreen}"
                                                            BorderBrush="{StaticResource CatppuccinText}"
                                                            BorderThickness="0,0,2,0"
                                                            Opacity="0.35"/>
                                                </Grid>
                                            </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Pattern blocks (playlist) — distinct dashed blocks -->
                            <ItemsControl ItemsSource="{Binding PatternClips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter" x:DataType="tl:PatternClipViewModel">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding $parent[ItemsControl].DataContext.ClipTopInset}"/>
                                        <Setter Property="Width" Value="{Binding Width}"/>
                                        <Setter Property="Height" Value="{Binding $parent[ItemsControl].DataContext.ClipHeight}"/>
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tl:PatternClipViewModel">
                                        <Border Classes="pattern-clip" CornerRadius="4" ClipToBounds="True"
                                                Classes.selected="{Binding IsSelected}"
                                                Background="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}"
                                                BorderBrush="{StaticResource CatppuccinCrust}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Timeline_Duplicate}" Command="{Binding DuplicateCommand}"/>
                                                    <MenuItem Header="{DynamicResource Timeline_Delete}" Command="{Binding DeleteCommand}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Rectangle Stroke="{StaticResource CatppuccinCrust}"
                                                           StrokeDashArray="4,3" StrokeThickness="1"
                                                           Margin="3" IsHitTestVisible="False"/>
                                                <StackPanel Margin="6,4" Spacing="2" IsHitTestVisible="False">
                                                    <TextBlock Text="{DynamicResource Timeline_PATTERN}" FontSize="8" FontWeight="Bold"
                                                               Foreground="{StaticResource CatppuccinCrust}" Opacity="0.7"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource CatppuccinCrust}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Group lane: aggregate child clips as coloured mini bars -->
                            <ItemsControl ItemsSource="{Binding GroupSummaries}" IsVisible="{Binding IsGroup}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter" x:DataType="tl:GroupClipSummaryViewModel">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding $parent[ItemsControl].DataContext.ClipTopInset}"/>
                                        <Setter Property="Width" Value="{Binding Width}"/>
                                        <Setter Property="Height" Value="{Binding $parent[ItemsControl].DataContext.ClipHeight}"/>
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tl:GroupClipSummaryViewModel">
                                        <Border Classes="group-summary" CornerRadius="4" ClipToBounds="True"
                                                Background="{StaticResource CatppuccinSurface0}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Timeline_Duplicate}" Command="{Binding DuplicateCommand}"/>
                                                    <MenuItem Header="{DynamicResource Timeline_Reverse}" Command="{Binding ReverseCommand}"
                                                              IsVisible="{Binding IsAllAudio}"/>
                                                    <MenuItem Header="{DynamicResource Timeline_Render_clip_to_new_track}"
                                                              Command="{Binding RenderToNewTrackCommand}"/>
                                                    <MenuItem Header="{DynamicResource Timeline_Delete}" Command="{Binding DeleteCommand}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                            <ItemsControl ItemsSource="{Binding ChildBars}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerTheme>
                                                    <ControlTheme TargetType="ContentPresenter" x:DataType="tl:GroupChildClipBarViewModel">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                        <Setter Property="Width" Value="{Binding Width}"/>
                                                        <Setter Property="Height" Value="{Binding BarHeight}"/>
                                                    </ControlTheme>
                                                </ItemsControl.ItemContainerTheme>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="tl:GroupChildClipBarViewModel">
                                                        <Border CornerRadius="2" ClipToBounds="True"
                                                                Background="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}">
                                                            <Grid>
                                                                <controls:WaveformControl Waveform="{Binding Waveform}"
                                                                                          Revision="{Binding WaveformRevision}"
                                                                                          StartFraction="{Binding WaveStartFraction}"
                                                                                          EndFraction="{Binding WaveEndFraction}"
                                                                                          IsVisible="{Binding IsAudio}"
                                                                                          IsHitTestVisible="False"
                                                                                          Fill="{StaticResource CatppuccinCrust}"
                                                                                          Opacity="0.55"/>
                                                                <controls:MidiNoteMiniControl Notes="{Binding Notes}"
                                                                                              ClipLengthBeats="{Binding ClipLengthBeats}"
                                                                                              Revision="{Binding NotesRevision}"
                                                                                              IsVisible="{Binding IsMidi}"
                                                                                              IsHitTestVisible="False"
                                                                                              Fill="{StaticResource CatppuccinCrust}"
                                                                                              Opacity="0.6" Margin="1,1"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Width="{Binding RenderProgressWidth}"
                                                    HorizontalAlignment="Left"
                                                    IsVisible="{Binding IsRendering}"
                                                    IsHitTestVisible="False"
                                                    Background="{StaticResource CatppuccinGreen}"
                                                    BorderBrush="{StaticResource CatppuccinText}"
                                                    BorderThickness="0,0,2,0"
                                                    Opacity="0.35"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Drop highlight while dragging an audio file over this lane -->
                            <Border IsVisible="{Binding IsDropTarget}" IsHitTestVisible="False"
                                    BorderBrush="{StaticResource CatppuccinMauve}" BorderThickness="2">
                                <Rectangle Fill="{StaticResource CatppuccinMauve}" Opacity="0.2"/>
                            </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <!-- Automation lane (the editable curve) -->
                    <DataTemplate DataType="tl:AutomationLaneViewModel">
                        <Grid Width="{Binding LaneWidth}" Height="{Binding Height}" HorizontalAlignment="Left">
                            <Border Background="{StaticResource CatppuccinMantle}"
                                    BorderBrush="{StaticResource CatppuccinCrust}" BorderThickness="0,0,0,1"
                                    IsHitTestVisible="False"/>
                            <Grid>
                                <controls:TimelineGridControl IsHitTestVisible="False" Opacity="0.5"
                                                              PixelsPerBeat="{Binding Metrics.PixelsPerBeat}"
                                                              TotalBeats="{Binding Metrics.TotalBeats}"
                                                              BeatsPerBar="{Binding Metrics.BeatsPerBar}"
                                                              HorizontalOffset="{Binding Metrics.HorizontalOffset}"/>
                                <controls:AutomationLaneControl Revision="{Binding Revision}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                    <!-- Take lane -->
                    <DataTemplate DataType="tl:TakeLaneViewModel">
                        <Border Width="{Binding LaneWidth}" Height="{Binding Height}" HorizontalAlignment="Left"
                                Background="{StaticResource CatppuccinCrust}"
                                BorderBrush="{StaticResource CatppuccinMantle}" BorderThickness="0,0,0,1">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Timeline_Promote_take}" Command="{Binding PromoteTakeCommand}"/>
                                    <MenuItem Header="{DynamicResource Timeline_Flatten_comp}" Command="{Binding FlattenCompCommand}"/>
                                    <MenuItem Header="{DynamicResource Timeline_Split_comp_at_playhead}" Command="{Binding SplitCompAtPlayheadCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ItemsControl ItemsSource="{Binding Takes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme TargetType="ContentPresenter" x:DataType="tl:TakeViewModel">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding $parent[ItemsControl].DataContext.TakeTopInset}"/>
                                        <Setter Property="Width" Value="{Binding Width}"/>
                                        <Setter Property="Height" Value="{Binding $parent[ItemsControl].DataContext.TakeClipHeight}"/>
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tl:TakeViewModel">
                                        <Button Command="{Binding SelectCommand}" Padding="4,2" CornerRadius="3"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="{StaticResource CatppuccinSurface1}">
                                            <TextBlock Text="{Binding Label}" FontSize="9"
                                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <!-- Drop overlay: "New audio track" ghost shown when dragging below the last lane, plus the
                 clip-move ghost showing where a clip dragged onto another track will land -->
            <Canvas Grid.Row="1" Grid.Column="1" Name="DropOverlay" IsHitTestVisible="False">
                <Border Name="NewTrackGhost" Height="64" IsVisible="False" CornerRadius="2"
                        BorderBrush="{StaticResource CatppuccinGreen}" BorderThickness="2">
                    <Grid>
                        <Rectangle Fill="{StaticResource CatppuccinGreen}" Opacity="0.2"/>
                        <TextBlock Name="NewTrackGhostLabel" Text="{DynamicResource Timeline_New_audio_track}" Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{StaticResource CatppuccinGreen}"/>
                    </Grid>
                </Border>
                <Border Name="ClipDragGhost" Height="52" IsVisible="False" CornerRadius="3" Opacity="0.6"
                        BorderBrush="{StaticResource CatppuccinMauve}" BorderThickness="2">
                    <Rectangle Fill="{StaticResource CatppuccinMauve}" Opacity="0.25"/>
                </Border>
            </Canvas>

            <!-- Playhead + start marker lines (and the select-mode rubber band) over the lanes -->
            <Canvas Grid.Row="1" Grid.Column="1" Name="PlayheadOverlay" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Name="LoopRegion" IsVisible="False" Fill="{StaticResource CatppuccinSky}" Opacity="0.12"/>
                <Rectangle Name="StartMarkerLine" Width="1" IsVisible="False"
                           Fill="{StaticResource CatppuccinOverlay1}"/>
                <ItemsControl Name="MarkerLaneLines" ItemsSource="{Binding Markers}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="tl:ArrangementMarkerViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tl:ArrangementMarkerViewModel">
                            <Rectangle Width="1" Fill="{StaticResource CatppuccinYellow}" Opacity="0.35"
                                       Height="{Binding $parent[ItemsControl].Bounds.Height}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Name="PlayheadLine" Width="2" IsVisible="False"
                           Fill="{StaticResource CatppuccinGreen}"/>
                <Border Name="Band" IsVisible="False"
                        BorderBrush="{StaticResource CatppuccinMauve}" BorderThickness="1">
                    <Rectangle Fill="{StaticResource CatppuccinMauve}" Opacity="0.2"/>
                </Border>
            </Canvas>

            <!-- Start-marker play icon + punch brackets in the ruler (viewport-anchored) -->
            <Canvas Grid.Row="0" Grid.Column="1" Name="RulerOverlay" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Name="LoopRegionRuler" IsVisible="False" Height="{StaticResource RulerHeight}"
                           Fill="{StaticResource CatppuccinSky}" Opacity="0.25"/>
                <Border Name="PunchBracketLeft" IsVisible="False" Width="2" Height="{StaticResource RulerHeight}"
                        BorderBrush="{StaticResource CatppuccinRed}" BorderThickness="2,0,0,0"/>
                <Border Name="PunchBracketRight" IsVisible="False" Width="2" Height="{StaticResource RulerHeight}"
                        BorderBrush="{StaticResource CatppuccinRed}" BorderThickness="0,0,2,0"/>
                <Path Name="StartMarkerIcon" IsVisible="False" Data="M0,0 L9,5 L0,10 Z"
                      Fill="{StaticResource CatppuccinGreen}"/>
            </Canvas>

            <!-- Track-reorder drag indicator: a horizontal insertion line spanning headers + lanes,
                 indented to the would-be nesting depth. -->
            <Canvas Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="DragOverlay" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Name="DragInsertLine" Height="3" IsVisible="False"
                           Fill="{StaticResource CatppuccinYellow}"/>
            </Canvas>

            <!-- Slim header-column width resize grip (no visible splitter chrome) -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Name="HeaderWidthGrip"
                    Width="4" HorizontalAlignment="Right" Background="Transparent"
                    Cursor="SizeWestEast" IsHitTestVisible="True"/>
        </Grid>
        </Grid>
    </Border>
</UserControl>
