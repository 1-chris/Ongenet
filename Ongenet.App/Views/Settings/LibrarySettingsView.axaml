<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ongenet.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
             x:Class="Ongenet.App.Views.Settings.LibrarySettingsView"
             x:DataType="vm:LibrarySettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="14" Spacing="14">
            <TextBlock Text="{DynamicResource SettingsLibrary_Sample_folders}" FontWeight="Bold" FontSize="13"
                       Foreground="{StaticResource CatppuccinText}"/>
            <TextBlock Text="{DynamicResource SettingsLibrary_Folders_scanned_for_the_Samples_library_tab}" FontSize="11"
                       Foreground="{StaticResource CatppuccinSubtext0}"/>
            <Border Height="130" CornerRadius="4" Background="{StaticResource CatppuccinMantle}"
                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                <ListBox ItemsSource="{Binding SamplePaths}" SelectedItem="{Binding SelectedSamplePath, Mode=TwoWay}"
                         Background="Transparent"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{DynamicResource SettingsLibrary_Add_folder}" Click="OnAddSample" Background="{StaticResource CatppuccinSurface1}"/>
                <Button Content="{DynamicResource SettingsLibrary_Remove}" Click="OnRemoveSample" Background="{StaticResource CatppuccinSurface1}"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource SettingsLibrary_Sound_font_folders}" FontWeight="Bold" FontSize="13" Margin="0,8,0,0"
                       Foreground="{StaticResource CatppuccinText}"/>
            <TextBlock Text="{DynamicResource SettingsLibrary_Folders_scanned_for_sf2_sfz_in_the_Soundfonts_li}" FontSize="11"
                       Foreground="{StaticResource CatppuccinSubtext0}"/>
            <Border Height="130" CornerRadius="4" Background="{StaticResource CatppuccinMantle}"
                    BorderBrush="{StaticResource CatppuccinSurface1}" BorderThickness="1">
                <ListBox ItemsSource="{Binding SoundFontPaths}" SelectedItem="{Binding SelectedSoundFontPath, Mode=TwoWay}"
                         Background="Transparent"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{DynamicResource SettingsLibrary_Add_folder}" Click="OnAddSoundFont" Background="{StaticResource CatppuccinSurface1}"/>
                <Button Content="{DynamicResource SettingsLibrary_Remove}" Click="OnRemoveSoundFont" Background="{StaticResource CatppuccinSurface1}"/>
            </StackPanel>

            <CheckBox Content="{DynamicResource SettingsLibrary_Auto_play_files_when_selected}" Margin="0,8,0,0"
                      IsChecked="{Binding AutoPlay, Mode=TwoWay}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
