<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ongenet.App.ViewModels"
             xmlns:audio="using:Ongenet.Core.Audio"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="320"
             x:Class="Ongenet.App.Views.Settings.AudioSettingsView"
             x:DataType="vm:AudioDevicesViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Spacing="14">
            <TextBlock Text="{DynamicResource SettingsAudio_Audio_devices}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource CatppuccinText}"/>

            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SettingsAudio_Output}" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinSubtext1}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}"
                          ToolTip.Tip="{DynamicResource SettingsAudio_Audio_output_device_Tip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="audio:AudioDevice">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SettingsAudio_Input}" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinSubtext1}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}"
                          ToolTip.Tip="{DynamicResource SettingsAudio_Audio_input_device_for_recording_Tip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="audio:AudioDevice">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SettingsAudio_Input_mode}" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinSubtext1}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="140"
                          ItemsSource="{Binding InputChannelModes}" SelectedItem="{Binding InputChannelMode}"
                          ToolTip.Tip="{DynamicResource SettingsAudio_Record_the_input_as_Stereo_as_is_or_Mono_centere_Tip}"/>
            </Grid>

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CatppuccinOverlay1}"
                       Text="{DynamicResource SettingsAudio_Changing_the_output_device_reopens_the_audio_str}"/>

            <CheckBox Content="{DynamicResource SettingsAudio_WASAPI_exclusive_mode_lower_latency}"
                      IsChecked="{Binding WasapiExclusiveMode}"
                      IsVisible="{Binding ShowWasapiExclusive}"
                      ToolTip.Tip="{DynamicResource SettingsAudio_Use_exclusive_WASAPI_output_on_Windows_for_lower_Tip}"/>

            <Grid ColumnDefinitions="180,*" IsVisible="{Binding ShowCoreAudioLead}"
                  ToolTip.Tip="macOS: additional CoreAudio producer buffer (jitter slack). 4096 is safer under heavy mixes; requires restarting audio.">
                <TextBlock Grid.Column="0" Text="CoreAudio safety buffer" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinSubtext1}"/>
                <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                          ItemsSource="{Binding CoreAudioLeadOptions}"
                          SelectedItem="{Binding CoreAudioLeadFrames}"/>
            </Grid>

            <CheckBox Content="{DynamicResource SettingsAudio_Send_MIDI_clock_24_PPQN}"
                      IsChecked="{Binding MidiClockEnabled}"
                      ToolTip.Tip="{DynamicResource SettingsAudio_Send_MIDI_Start_Stop_and_Clock_to_the_selected_M_Tip}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
