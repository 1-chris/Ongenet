<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ongenet.App.ViewModels"
             xmlns:midi="using:Ongenet.Core.Audio.Midi"
             xmlns:services="using:Ongenet.App.Services"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="560"
             x:Class="Ongenet.App.Views.Settings.MidiSettingsView"
             x:DataType="vm:MidiSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.Section">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CatppuccinText}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style Selector="Button.Small">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{StaticResource CatppuccinSurface0}"/>
            <Setter Property="Foreground" Value="{StaticResource CatppuccinText}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Spacing="10">

            <!-- Input devices -->
            <TextBlock Classes="Section" Text="{DynamicResource SettingsMidi_MIDI_input}" Margin="0"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <Button Classes="Small" Content="{DynamicResource SettingsMidi_Refresh}" Click="RefreshDevices_Click"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding DeviceRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MidiDeviceRow">
                        <CheckBox Content="{Binding Device.DisplayName}" IsChecked="{Binding IsEnabled}"
                                  Margin="0,2" Foreground="{StaticResource CatppuccinText}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding BackendNote}" FontSize="11" Foreground="{StaticResource CatppuccinOverlay1}"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{DynamicResource SettingsMidi_Activity}" FontSize="11" Foreground="{StaticResource CatppuccinSubtext0}"/>
                <TextBlock Text="{Binding Activity}" FontSize="11"
                           FontFamily="Consolas, Menlo, DejaVu Sans Mono, Monospace"
                           Foreground="{StaticResource CatppuccinGreen}"/>
            </StackPanel>

            <!-- Recording -->
            <TextBlock Classes="Section" Text="{DynamicResource SettingsMidi_Recording}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource SettingsMidi_Input_quantize}" VerticalAlignment="Center"
                           Foreground="{StaticResource CatppuccinSubtext1}"/>
                <ComboBox Width="140" ItemsSource="{Binding QuantizeOptions}" SelectedItem="{Binding SelectedQuantize}"
                          ToolTip.Tip="{DynamicResource SettingsMidi_Snap_recorded_note_starts_to_this_grid_Tip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuantizeOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Transport control mapping -->
            <TextBlock Classes="Section" Text="{DynamicResource SettingsMidi_Transport_control}"/>
            <ItemsControl ItemsSource="{Binding TransportRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransportMapRow">
                        <Grid ColumnDefinitions="120,70,Auto,Auto" Margin="0,3" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding ActionName}" VerticalAlignment="Center"
                                       Foreground="{StaticResource CatppuccinText}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Binding}" VerticalAlignment="Center"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <Button Grid.Column="2" Classes="Small" Content="{Binding LearnText}" Click="LearnTransport_Click"/>
                            <Button Grid.Column="3" Classes="Small" Content="{DynamicResource SettingsMidi_Clear}" Click="ClearTransport_Click"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Keyboard shortcuts -->
            <TextBlock Classes="Section" Text="{DynamicResource SettingsMidi_Keyboard_shortcuts}"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource CatppuccinOverlay1}"
                       Text="{DynamicResource SettingsMidi_Global_shortcuts_for_arrangement_editing_and_sec}"/>
            <ItemsControl ItemsSource="{Binding ShortcutRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:KeyboardShortcutRow">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                       Foreground="{StaticResource CatppuccinText}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Binding}" VerticalAlignment="Center"
                                       Foreground="{StaticResource CatppuccinSubtext0}"/>
                            <Button Grid.Column="2" Classes="Small" Content="{DynamicResource SettingsMidi_Reset}" Click="ResetShortcut_Click"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Session MIDI mappings (per project) -->
            <TextBlock Classes="Section" Text="Session MIDI mappings"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource CatppuccinOverlay1}"
                       Text="Learn bindings from the Session view (slot/scene context menu) or remove them here. Saved with the project."/>
            <ItemsControl ItemsSource="{Binding SessionMappingRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionMidiMapRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource CatppuccinText}"/>
                            <Button Grid.Column="1" Classes="Small" Content="{DynamicResource SettingsMidi_Remove}" Click="RemoveSessionMapping_Click"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- CC → parameter mappings -->
            <TextBlock Classes="Section" Text="{DynamicResource SettingsMidi_Parameter_mappings}"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource CatppuccinOverlay1}"
                       Text="{DynamicResource SettingsMidi_Right_click_any_knob_or_parameter_and_choose_MID}"/>
            <ItemsControl ItemsSource="{Binding Mappings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MidiMappingRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource CatppuccinText}"/>
                            <Button Grid.Column="1" Classes="Small" Content="{DynamicResource SettingsMidi_Remove}" Click="RemoveMapping_Click"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
