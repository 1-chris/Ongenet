#!/bin/sh
set -e
CONFIG="$HOME/Library/Application Support/Ongenet"
mkdir -p "$CONFIG"
INSTALL_PATH="/Applications/Ongenet.app"
VERSION="@VERSION@"
DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
cat > "$CONFIG/install.json" <<EOF
{
  "method": "pkg",
  "installPath": "$INSTALL_PATH",
  "version": "$VERSION",
  "installedAt": "$DATE"
}
EOF
exit 0
