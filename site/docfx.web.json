{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "Ongenet.Web/Ongenet.Web.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "api",
      "filter": "filter.yml",
      "properties": {
        "TargetFramework": "net10.0-browser"
      }
    }
  ],
  "build": {
    "content": [],
    "resource": [],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/onge"
    ]
  }
}
