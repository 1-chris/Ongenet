<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Desktop application head. Thin: it brings the native stack (Avalonia.Desktop platform backends,
        Ongenet.Audio, Ongenet.Clap, Ongenet.Lv2, Ongenet.Vst) and plugs it into the shared Ongenet.App UI library via
        DesktopPlatform. The runnable artifact stays named "Ongenet" for users.
    -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>Ongenet</AssemblyName>
        <RootNamespace>Ongenet.Desktop</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- Not PublishSingleFile: Roslyn's MetadataReference.CreateFromFile needs Assembly.Location,
             which is empty (and TRUSTED_PLATFORM_ASSEMBLIES is unset) under single-file publish. -->
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ongenet.App\Ongenet.App.csproj" />
        <ProjectReference Include="..\Ongenet.Core\Ongenet.Core.csproj" />
        <ProjectReference Include="..\Ongenet.Audio\Ongenet.Audio.csproj" />
        <!-- Native GPU 3D engine: referenced only by the desktop head and injected via DI. -->
        <ProjectReference Include="..\Ongenet.Engine3D\Ongenet.Engine3D.csproj" />
        <ProjectReference Include="..\Ongenet.Clap\Ongenet.Clap.csproj" />
        <ProjectReference Include="..\Ongenet.Lv2\Ongenet.Lv2.csproj" />
        <ProjectReference Include="..\Ongenet.Vst\Ongenet.Vst.csproj" />
        <ProjectReference Include="..\Ongenet.Au\Ongenet.Au.csproj" />
        <ProjectReference Include="..\Ongenet.Link\Ongenet.Link.csproj" />
        <ProjectReference Include="..\Ongenet.Ara\Ongenet.Ara.csproj" />
        <ProjectReference Include="..\Ongenet.Scripting\Ongenet.Scripting.csproj" />
        <ProjectReference Include="..\Ongenet.Scripting.Editor\Ongenet.Scripting.Editor.csproj" />
        <ProjectReference Include="..\Ongenet.VideoComposition\Ongenet.VideoComposition.csproj" />
        <ProjectReference Include="..\Ongenet.VideoComposition.Editor\Ongenet.VideoComposition.Editor.csproj" />
        <ProjectReference Include="..\Ongenet.PluginHost\Ongenet.PluginHost.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

    <PropertyGroup>
        <!-- PluginHost lands under bin/<cfg>/<tfm>/<rid>/ when publishing with -r. -->
        <_PluginHostBinDir>..\Ongenet.PluginHost\bin\$(Configuration)\$(TargetFramework)\</_PluginHostBinDir>
        <_PluginHostBinDir Condition="'$(RuntimeIdentifier)' != ''">..\Ongenet.PluginHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</_PluginHostBinDir>
    </PropertyGroup>

    <Target Name="CopyPluginHost" AfterTargets="Build;Publish">
        <MSBuild Projects="..\Ongenet.PluginHost\Ongenet.PluginHost.csproj"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)"
                 Targets="Build" />
        <ItemGroup>
            <PluginHostOutput Include="$(_PluginHostBinDir)Ongenet.PluginHost*" />
            <PluginHostOutput Include="$(_PluginHostBinDir)Ongenet.PluginHost.runtimeconfig.json" Condition="Exists('$(_PluginHostBinDir)Ongenet.PluginHost.runtimeconfig.json')" />
            <PluginHostOutput Include="$(_PluginHostBinDir)Ongenet.PluginHost.deps.json" Condition="Exists('$(_PluginHostBinDir)Ongenet.PluginHost.deps.json')" />
        </ItemGroup>
        <PropertyGroup>
            <_PluginHostDestination Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')">$(PublishDir)</_PluginHostDestination>
            <_PluginHostDestination Condition="'$(_PluginHostDestination)' == ''">$(OutputPath)</_PluginHostDestination>
        </PropertyGroup>
        <Copy SourceFiles="@(PluginHostOutput)" DestinationFolder="$(_PluginHostDestination)" SkipUnchangedFiles="true" />
    </Target>

    <!-- Copy libabl-link next to the executable when auto-detected at build time. -->
    <ItemGroup Condition="'$(OngenetLinkNative)' == 'true'">
        <NativeLinkLib Include="$(MSBuildThisFileDirectory)..\third_party\link\build\libabl-link.dylib" Condition="Exists('$(MSBuildThisFileDirectory)..\third_party\link\build\libabl-link.dylib')" />
        <NativeLinkLib Include="$(MSBuildThisFileDirectory)..\third_party\link\build\libabl-link.so" Condition="Exists('$(MSBuildThisFileDirectory)..\third_party\link\build\libabl-link.so')" />
        <NativeLinkLib Include="$(MSBuildThisFileDirectory)..\third_party\link\build\abl-link.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\third_party\link\build\abl-link.dll')" />
        <NativeLinkLib Include="$(MSBuildThisFileDirectory)..\build\link\libabl-link.dylib" Condition="Exists('$(MSBuildThisFileDirectory)..\build\link\libabl-link.dylib')" />
        <NativeLinkLib Include="$(MSBuildThisFileDirectory)..\build\link\libabl-link.so" Condition="Exists('$(MSBuildThisFileDirectory)..\build\link\libabl-link.so')" />
        <NativeLinkLib Include="$(MSBuildThisFileDirectory)..\build\link\abl-link.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\build\link\abl-link.dll')" />
    </ItemGroup>
    <Target Name="CopyNativeLinkLib" AfterTargets="Build" Condition="'$(OngenetLinkNative)' == 'true' and '@(NativeLinkLib)' != ''">
        <Copy SourceFiles="@(NativeLinkLib)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    </Target>
</Project>
